<%- include ("../partials/header.ejs") %>
  <link href="https://fonts.googleapis.com/css2?family=Inknut+Antiqua:wght@400;700&display=swap" rel="stylesheet">

  <style>
    /*
        SCREEN
    */
    :root {
      --background-color: #000000;
      /* Dark background */
      --pink-color: #FF1493;
      /* Deep Pink */
      --primary-color: var(--pink-color);
    }

    * {
      box-sizing: border-box;
    }

    body {
      height: 100vh;
      place-items: center;
      background-color: var(--background-color);
      margin: 0;
      overflow: hidden;
      padding: 0;
      font-family: 'Inknut Antiqua', serif;
      justify-content: center;
      align-items: center;
      color: white;
      overflow: auto;
    }

    #screens-container {
      display: flex;
      justify-content: space-around;
      align-items: center;
      width: 100%;
    }

    .screen {
      width: 350px;
      display: flex;
      border: 3px solid rgba(255, 20, 147, 0.8);
      /* Deep Pink with opacity */
      aspect-ratio: 10 / 16;
      border-radius: 1rem;
      background-color: rgba(255, 20, 147, 0.15);
      /* Deep Pink with opacity */
      overflow: hidden;
      position: relative;
      z-index: 10;
      margin: 0 20px;
    }

    /*
        Animation des lignes qui bouge
    */
    @keyframes pan-overlay {
      from {
        background-position: 0% 0%;
      }

      to {
        background-position: 0% -100%;
      }
    }

    .screen-overlay {
      background: linear-gradient(rgba(250, 0, 134, 0.263),
          rgba(177, 4, 96, 0.764) 3px,
          transparent 3px,
          transparent 9px);
      background-size: 100% 9px;
      height: 100%;
      width: 100%;
      animation: pan-overlay 22s infinite linear;
      position: absolute;
      z-index: 2;
      left: 0;
      top: 0;
    }

    .screen>.screen-image {
      background-image: url("https://images.unsplash.com/photo-1607419726991-5fc7e74cda67?q=80&w=1887&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
      height: 100%;
      width: 100%;
      position: absolute;
      z-index: 1;
      left: 0;
      top: 0;
      background-size: 300%;
      background-position: 0% 0%;
      filter: sepia(100%) hue-rotate(160deg);
      opacity: 0.6;
      animation: pan-image 15s linear infinite;
    }

    .screen>.screen-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      flex-grow: 1;
      gap: 4rem;
      position: relative;
      z-index: 3;
      margin: 1rem;
      padding-bottom: 6rem;
      border: 1px solid rgba(255, 20, 147, 0.5);
      /* Deep Pink with opacity */
      border-radius: 0.6rem;
    }

    .screen>.screen-content>.screen-icon {
      color: white;
      font-size: 4rem;
      text-shadow: 0px 0px 0.5rem white;
    }

    .screen>.screen-content>.screen-user {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      position: relative;
    }

    .screen>.screen-content>.screen-user:before,
    .screen>.screen-content>.screen-user:after {
      content: "";
      position: absolute;
      top: 0;
      background-color: var(--primary-color);
      /* Deep Pink */
      border-radius: 1rem;
      box-shadow: 0px 0px 8px 3px rgba(255, 20, 147, 0.6);
      /* Deep Pink with opacity */
    }

    /* THE LINE IN THE MIDDLE 
    .screen>.screen-content>.screen-user:before {
      height: 2px;
      width: 50px;
      translate: -20px -1rem;
      opacity: 0.75;
    }

    .screen>.screen-content>.screen-user:after {
      height: 3px;
      width: 30px;
      translate: 26px calc(-1rem - 0.5px);
    }*/

    .screen>.screen-content>.screen-user>.link {
      opacity: 0.8;
      font-size: 1.5rem;
      text-shadow: 0px 0px 0.5rem white;
      font-weight: 400;
      letter-spacing: 0.3rem;
      text-decoration: none;
    }

    .screen>.screen-content>.screen-user>.link:is(:hover, :focus) {
      text-decoration: underline;
    }

    .screen-content .screen-user .name,
    .screen-content .screen-user .price,
    .screen-content .screen-user .features li {
      color: white;
      /* THE TEXXT COLOUR */
    }

    #blur {
      height: 100%;
      width: 100%;
      position: absolute;
      z-index: 2;
      backdrop-filter: blur(12vmax);
    }

    /* -- Links -- */
    #links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 10;
      padding: 1rem;
    }

    .meta-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .meta-link> :is(span, a) {
      font-family: "Rubik", sans-serif;
      font-size: 0.9rem;
      color: white;
    }

    .meta-link>.label {
      width: 160px;
      text-align: right;
    }

    .meta-link>a {
      text-decoration: none;
      outline: none;
    }

    .meta-link>a.source {
      color: rgb(210, 94, 204);
    }

    .meta-link>a:is(:hover, :focus)>i {
      color: white;
    }

    .meta-link>a.youtube {
      color: rgb(239, 83, 80);
    }

    .meta-link>a.youtube>i {
      padding-top: 0.2rem;
    }

    .meta-link>a>i {
      height: 1rem;
      line-height: 1rem;
    }

    /* THE ACHETER BUTTON*/
    .custom_butt {
      background-color: #A82D75;
      color: white;
      padding: 10px 20px;
      font-size: 20px;
      margin-top: 30px;
      border: none;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .custom_butt:hover {
      background-color: #000000;
    }
  </style>

  <body>
    <div id="screens-container">
      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <span class="name" data-value="Basic">Basic</span>
            <span class="price">0$</span>
            <ul class="features">
              <li>Limited Swipes (5 par jours)</li>
            </ul>
            <button type="submit" class="custom_butt">Confirmer</button>
          </div>
        </div>
      </div>
      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <span class="name" data-value="Premium">Premium</span>
            <span class="price">19.47$</span>
            <ul class="features">
              <li>100 swipes a chaque semaines</li>
            </ul>
            <button type="submit" class="custom_butt">Confirmer</button>
          </div>
        </div>
      </div>
      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <span class="name" data-value="Diamond">Diamond</span>
            <span class="price">25.47$</span>
            <ul class="features">
              <li>Swipes Illimité</li>
            </ul>
            <button type="submit" class="custom_butt">Confirmer</button>
          </div>
        </div>
      </div>
    </div>
  </body>

  </html>
  <script>

    const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";

    let interval = null;

    //SCREEENS
    const screens = document.querySelectorAll(".screen");

    screens.forEach(screen => {
      const name = screen.querySelector(".name");

      screen.onmouseenter = event => {
        let iteration = 0;

        clearInterval(interval);

        interval = setInterval(() => {
          name.innerText = name.innerText
            .split("")
            .map((letter, index) => {
              if (index < iteration) { return name.dataset.value[index]; }
              return letters[Math.floor(Math.random() * 26)];
            })
            .join("");

          if (iteration >= name.dataset.value.length) {
            clearInterval(interval);
          }

          iteration += 1 / 3;
        }, 30);
      };
    });

  </script>

  <%- include ("../partials/footer.ejs") %>