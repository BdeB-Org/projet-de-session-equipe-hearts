<%- include ("../partials/header.ejs") %>

  <style>
    html,
    body {
      height: 100%;
      margin: 0;
      padding: 0;
      overflow-y: auto;
      /* Ensures the page can scroll vertically */
    }

    /*
        SCREEN
    */
    body {
      height: 100vh;
      justify-content: center;
      align-items: center;
      background-color: #000000;
      /* Dark background */
      margin: 0;
      padding: 0;
      font-family: "Orbitron", sans-serif;
      color: white;
      overflow: hidden;
    }

    #screens-container {
      display: flex;
      justify-content: space-around;
      align-items: center;
      width: 100%;
    }

    .screen {
      width: 350px;
      display: flex;
      flex-direction: column;
      /* Stack content vertically */
      border: 3px solid rgba(255, 20, 147, 0.8);
      aspect-ratio: 10 / 16;
      border-radius: 1rem;
      background-color: rgba(255, 20, 147, 0.15);
      overflow: hidden;
      position: relative;
      z-index: 10;
      margin: 0 20px;
      transition: box-shadow 0.3s ease;
      /* Smooth shadow transition */
      backdrop-filter: blur(8px);
      /* Adding blur for background */
    }

    /* Shadow border effect on hover */
    .screen:hover {
      box-shadow: 0 0 20px #1E90FF;
      /* Fixed complementary shadow color */
    }

    .screen-image {
      background-image: url("https://images.unsplash.com/photo-1561344640-2453889cde5b?q=80&w=1934&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
      height: 100%;
      width: 100%;
      position: absolute;
      z-index: 1;
      background-size: cover;
      background-position: center;
      opacity: 0.6;
    }

    .screen-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      /* Space elements evenly */
      flex-grow: 1;
      gap: 1.5rem;
      /* Increased spacing between elements */
      position: relative;
      z-index: 3;
      margin: 1rem;
      padding: 2rem 1rem;
      /* Added padding for top space */
      text-align: center;
      /* Centering text */
    }

    .screen-content h2 {
      font-size: 2.5rem;
      /* Adjust font size */
      margin: 0;
      text-shadow: 0 0 10px rgba(255, 20, 147, 0.9);
      /* Glow effect */
    }

    .screen-content p {
      font-size: 2rem;
      /* Font size for price */
      margin: 0;
      text-shadow: 0 0 5px rgba(255, 20, 147, 0.7);
      /* Glow effect */
    }

    .screen-content ul {
      font-size: 1.5rem;
      /* Font size for features */
      margin: 0;
      padding: 0;
      text-shadow: 0 0 5px rgba(255, 20, 147, 0.7);
      /* Glow effect */
      list-style-type: disc;
      /* Ensure list has bullets */
      padding-left: 20px;
      /* Indent the list */
    }

    .screen-content .custom_butt {
      background-color: #A82D75;
      color: white;
      padding: 10px 20px;
      font-size: 20px;
      border: none;
      border-radius: 0.5rem;
      transition: background-color 0.3s ease;
      width: 100%;
    }

    .custom_butt:disabled {
      background-color: #A82D75;
      opacity: 0.5;
      cursor: not-allowed;
      transition: none;
    }

    .custom_butt:hover {
      background-color: #000000;
    }


    .offset {
      box-shadow:
        0.3em 0.3em 0 0 #3498db,
        inset 0.3em 0.3em 0 0 #3498db;

      &:hover,
      &:focus {
        box-shadow:
          0 0 0 0 #91077a,
          inset 6em 3.5em 0 0 #7a0971;
      }
    }

    button {
      color: #ff00d4;
      transition: 0.25s;

      &:hover,
      &:focus {
        border-color: #7e328d;
        color: #270303;
      }
    }


    button {
      background: none;
      border: 2px solid;
      font: inherit;
      line-height: 1;
      margin: 0.5em;
      padding: 1em 2em;
    }

    /* Lines Animation */
    @keyframes pan-overlay {
      from {
        background-position: 0% 0%;
      }

      to {
        background-position: 0% -100%;
      }
    }

    .screen-overlay {
      background: linear-gradient(rgba(250, 0, 134, 0.263),
          rgba(177, 4, 96, 0.764) 3px,
          transparent 3px,
          transparent 9px);
      background-size: 100% 9px;
      height: 100%;
      width: 100%;
      animation: pan-overlay 22s infinite linear;
      position: absolute;
      z-index: 2;
      left: 0;
      top: 0;
    }

    #background-video {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -1;
    }
  </style>

  <body>
    <video autoplay muted loop id="background-video">
      <source src="/images/vecteezy_the-view-from-the-spaceship-looks-out-onto-a-parallel_49886908.mp4"
        type="video/mp4">
      Your browser does not support the video tag.
    </video>
    <div id="screens-container">
      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <h2 class="name" data-value="Basique">Basique</h2>
            <p class="price" data-value="0$/ Mois">0€ / Mois</p>
            <ul class="features" data-value="5 Swipes/J">
              <li>5 Swipes/J</li>
            </ul>
          </div>

          <% if (!userDetails) { %>
            <button onclick="window.location.href='/event/creationCompte'" class="custom_butt">
              Connectez-vous
            </button>
            <% } else if (Number(userDetails.abonnement_id)===1) { %>
              <button class="custom_butt" disabled>
                Vous avez déjà cet abonnement
              </button>
              <% } else { %>
                <button onclick="confirmChangePlan(1)" class="custom_butt">Changer de plan</button>

                <% } %>
        </div>
      </div>


      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <h2 class="name" data-value="Premium">Premium</h2>
            <p class="price" data-value="19,47$/ Mois">19,47$ / Mois</p>
            <ul class="features" data-value="100 Swipes/Semaine">
              <li>100 Swipes/Semaine</li>
            </ul>
          </div>
          <% if (!userDetails) { %>
            <button onclick="window.location.href='/event/creationCompte'" class="custom_butt">
              Connectez-vous
            </button>
            <% } else if (Number(userDetails.abonnement_id)===2) { %>
              <button class="custom_butt" disabled>
                Vous avez déjà cet abonnement
              </button>
              <% } else { %>
                <button onclick="goToPayment(19.47, 'Premium')" class="custom_butt">Changer de plan</button>
                <% } %>
        </div>
      </div>

      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <h2 class="name" data-value="Diamant">Diamant</h2>
            <p class="price" data-value="25,47$/ Mois">25,47$ / Mois</p>
            <ul class="features" data-value="Swipes Illimités">
              <li>Swipes Illimités</li>
            </ul>
          </div>
          <% if (!userDetails) { %>
            <button onclick="window.location.href='/event/creationCompte'" class="custom_butt">
              Connectez-vous
            </button>
            <% } else if (Number(userDetails.abonnement_id)===3) { %>
              <button class="custom_butt" disabled>
                Vous avez déjà cet abonnement
              </button>
              <% } else { %>
                <button onclick="goToPayment(25.47, 'Diamant')" class="custom_butt">Changer de plan</button>
                <% } %>
        </div>
      </div>
    </div>

    <script>
      function goToPayment(price, subscriptionType) {
        window.location.href = `/event/payment?amount=${price}&subscriptionType=${subscriptionType}`;
      }

      const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789€";
      let intervals = [];

      // SCREENS
      const screens = document.querySelectorAll(".screen");

      screens.forEach(screen => {
        const name = screen.querySelector(".name");
        const price = screen.querySelector(".price");
        const features = screen.querySelector(".features");
        const elementsToEncrypt = [name, price, features];

        screen.onmouseenter = () => {
          elementsToEncrypt.forEach((element, index) => {
            if (element.dataset.value) {
              let iteration = 0;

              if (intervals[index]) {
                clearInterval(intervals[index]);
              }

              intervals[index] = setInterval(() => {
                element.innerText = element.dataset.value
                  .split("")
                  .map((letter, idx) => {
                    if (idx < iteration) {
                      return element.dataset.value[idx];
                    }
                    return letters[Math.floor(Math.random() * letters.length)];
                  })
                  .join("");

                if (iteration >= element.dataset.value.length) {
                  clearInterval(intervals[index]);
                }
                iteration += 1 / 1;
              }, 30);
            }
          });
        };

        screen.onmouseleave = () => {
          elementsToEncrypt.forEach((element, index) => {
            if (intervals[index]) {
              clearInterval(intervals[index]);
            }
            if (element.dataset.value) {
              element.innerText = element.dataset.value;
            }
          });
        };
      });

      function changePlan(subscriptionId) {
        fetch('/event/change-plan', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({ abonnement_id: subscriptionId }),
        })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              window.location.reload(); // Refresh the page to update the button state
            } else {
              alert('Erreur lors du changement de plan');
            }
          })
          .catch((error) => {
            console.error('Erreur:', error);
          });
      }
      function confirmChangePlan(subscriptionId) {
        const confirmation = confirm('Êtes-vous sûr de vouloir changer de plan? Votre plan actuel se terminera maintenant.');

        if (confirmation) {
          // Proceed with the plan change
          changePlan(subscriptionId);
        }
      }


    </script>

    <%- include ("../partials/footer.ejs") %>