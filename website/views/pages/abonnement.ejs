<%- include ("../partials/header.ejs") %>

  <style>
    /*
        SCREEN
    */
    :root {
      --background-color: #000000;
      /* Dark background */
      --pink-color: #FF1493;
      /* Deep Pink */
      --primary-color: var(--pink-color);
    }

    * {
      box-sizing: border-box;
    }

    body {
      height: 100vh;
      place-items: center;
      background-color: var(--background-color);
      margin: 0;
      overflow: hidden;
      padding: 0;
      font-family: 'Inknut Antiqua', serif;
      justify-content: center;
      align-items: center;
      color: white;
      overflow: auto;
    }

    #screens-container {
      display: flex;
      justify-content: space-around;
      align-items: center;
      width: 100%;
    }

    .screen {
      width: 350px;
      display: flex;
      border: 3px solid rgba(255, 20, 147, 0.8);
      /* Deep Pink with opacity */
      aspect-ratio: 10 / 16;
      border-radius: 1rem;
      background-color: rgba(255, 20, 147, 0.15);
      /* Deep Pink with opacity */
      overflow: hidden;
      position: relative;
      z-index: 10;
      margin: 0 20px;
    }

    /*
        Animation des lignes qui bouge
    */
    @keyframes pan-overlay {
      from {
        background-position: 0% 0%;
      }

      to {
        background-position: 0% -100%;
      }
    }

    .screen-overlay {
      background: linear-gradient(rgba(250, 0, 134, 0.263),
          rgba(177, 4, 96, 0.764) 3px,
          transparent 3px,
          transparent 9px);
      background-size: 100% 9px;
      height: 100%;
      width: 100%;
      animation: pan-overlay 22s infinite linear;
      position: absolute;
      z-index: 2;
      left: 0;
      top: 0;
    }

    .screen>.screen-image {
      background-image: url("https://images.unsplash.com/photo-1561344640-2453889cde5b?q=80&w=1934&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D");
      height: 100%;
      width: 100%;
      position: absolute;
      z-index: 1;
      left: 0;
      top: 0;
      background-size: cover;
      background-position: center;
      opacity: 0.6;
      animation: pan-image 15s linear infinite;
    }

    .screen>.screen-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: flex-end;
      flex-grow: 1;
      gap: 4rem;
      position: relative;
      z-index: 3;
      margin: 1rem;
      padding-bottom: 6rem;
      border: 1px solid rgba(255, 20, 147, 0.5);
      /* Deep Pink with opacity */
      border-radius: 0.6rem;
    }

    .screen>.screen-content>.screen-icon {
      color: white;
      font-size: 4rem;
      text-shadow: 0px 0px 0.5rem white;
    }

    .screen>.screen-content>.screen-user {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      position: relative;
    }

    .screen>.screen-content>.screen-user:before,
    .screen>.screen-content>.screen-user:after {
      content: "";
      position: absolute;
      top: 0;
      background-color: var(--primary-color);
      /* Deep Pink */
      border-radius: 1rem;
      box-shadow: 0px 0px 8px 3px rgba(255, 20, 147, 0.6);
      /* Deep Pink with opacity */
    }

    .screen>.screen-content>.screen-user>.link {
      opacity: 0.8;
      font-size: 1.5rem;
      text-shadow: 0px 0px 0.5rem white;
      font-weight: 400;
      letter-spacing: 0.3rem;
      text-decoration: none;
    }

    .screen>.screen-content>.screen-user>.link:is(:hover, :focus) {
      text-decoration: underline;
    }

    .screen-content .screen-user .name,
    .screen-content .screen-user .price,
    .screen-content .screen-user .features li {
      color: white;
      /* THE TEXXT COLOUR */
    }

    #blur {
      height: 100%;
      width: 100%;
      position: absolute;
      z-index: 2;
      backdrop-filter: blur(12vmax);
    }

    /* -- Links -- */
    #links {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      position: absolute;
      top: 0;
      left: 0;
      z-index: 10;
      padding: 1rem;
    }

    .meta-link {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .meta-link> :is(span, a) {
      font-family: "Rubik", sans-serif;
      font-size: 0.9rem;
      color: white;
    }

    .meta-link>.label {
      width: 160px;
      text-align: right;
    }

    .meta-link>a {
      text-decoration: none;
      outline: none;
    }

    .meta-link>a.source {
      color: rgb(210, 94, 204);
    }

    .meta-link>a:is(:hover, :focus)>i {
      color: white;
    }

    .meta-link>a.youtube {
      color: rgb(239, 83, 80);
    }

    .meta-link>a.youtube>i {
      padding-top: 0.2rem;
    }

    .meta-link>a>i {
      height: 1rem;
      line-height: 1rem;
    }

    /* THE ACHETER BUTTON*/
    .custom_butt {
      background-color: #A82D75;
      color: white;
      padding: 10px 20px;
      font-size: 20px;
      margin-top: 30px;
      border: none;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .custom_butt:hover {
      background-color: #000000;
    }

    .offset {
      box-shadow:
        0.3em 0.3em 0 0 #3498db,
        inset 0.3em 0.3em 0 0 #3498db;

      &:hover,
      &:focus {
        box-shadow:
          0 0 0 0 #91077a,
          inset 6em 3.5em 0 0 #7a0971;
      }
    }

    button {
      color: #ff00d4;
      transition: 0.25s;

      &:hover,
      &:focus {
        border-color: #7e328d;
        color: #270303;
      }
    }


    button {
      background: none;
      border: 2px solid;
      font: inherit;
      line-height: 1;
      margin: 0.5em;
      padding: 1em 2em;
    }

    h1 {
      font-weight: 400;
    }

    code {
      color: #75093f;
      font: inherit;
    }
  </style>

  <body>
    <div id="screens-container">
      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <h2 class="name" data-value="Basique">Basique</h2>
            <p class="price" data-value="0€ / Mois">0$ / Mois</p>
            <ul class="features" data-value="5 Swipes par Jour">
              <li>5 Swipes par Jour</li>
            </ul>
            <button onclick="goToPayment(0, 'Basique')" class="custom_butt">Acheter</button>

          </div>
        </div>
      </div>

      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <h2 class="name" data-value="Premium">Premium</h2>
            <p class="price" data-value="19,47€ / Mois">19,47$ / Mois</p>
            <ul class="features" data-value="100 Swipes par Semaine">
              <li>100 Swipes par Semaine</li>
            </ul>
            <button onclick="goToPayment(19.47, 'Premium')" class="custom_butt">Acheter</button>

          </div>
        </div>
      </div>

      <div class="screen">
        <div class="screen-image"></div>
        <div class="screen-overlay"></div>
        <div class="screen-content">
          <div class="screen-user">
            <h2 class="name" data-value="Diamant">Diamant</h2>
            <p class="price" data-value="25,47€ / Mois">25,47$ / Mois</p>
            <ul class="features" data-value="Swipes Illimités">
              <li>Swipes Illimités</li>
            </ul>
            <button onclick="goToPayment(25.47, 'Diamant')" class="custom_butt">Acheter</button>

          </div>
        </div>
      </div>
    </div>
  </body>

  <script>

    function goToPayment(price, subscriptionType) {
      window.location.href = `/event/payment?amount=${price}&subscriptionType=${subscriptionType}`;
    }


    const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789€";
    let intervals = [];

    // SCREENS
    const screens = document.querySelectorAll(".screen");

    screens.forEach(screen => {
      const name = screen.querySelector(".name");
      const price = screen.querySelector(".price");
      const features = screen.querySelector(".features");
      const elementsToEncrypt = [name, price, features];

      screen.onmouseenter = () => {
        elementsToEncrypt.forEach((element, index) => {
          if (element.dataset.value) {
            let iteration = 0;

            if (intervals[index]) {
              clearInterval(intervals[index]);
            }

            intervals[index] = setInterval(() => {
              element.innerText = element.dataset.value
                .split("")
                .map((letter, idx) => {
                  if (idx < iteration) {
                    return element.dataset.value[idx];
                  }
                  return letters[Math.floor(Math.random() * letters.length)];
                })
                .join("");

              if (iteration >= element.dataset.value.length) {
                clearInterval(intervals[index]);
              }
              iteration += 1 / 3;
            }, 30);
          }
        });
      };

      screen.onmouseleave = () => {
        elementsToEncrypt.forEach((element, index) => {
          if (intervals[index]) {
            clearInterval(intervals[index]);
          }
          if (element.dataset.value) {
            element.innerText = element.dataset.value;
          }
        });
      };
    });


  </script>

  <%- include ("../partials/footer.ejs") %>