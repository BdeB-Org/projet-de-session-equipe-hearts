<%- include ("../partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Card Flip Animation</title>
    <style>
        body {
            background-color: #000000;
            position: relative;
            height: 100vh;
            margin: 0;
            justify-content: center;
            align-items: center;
            transition: filter 0.5s ease-in-out;
        }

        .cards {
            position: relative;
            transition: filter 0.5s ease-in-out;
        }

        .card {
            perspective: 1000px;
            position: absolute;
            transition: filter 0.5s ease-in-out;
            cursor: pointer;
        }

        .card-inner {
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transition: transform 0.6s ease-in-out;
            transform-origin: center;
        }

        .card:hover .card-inner {
            transform: rotateY(180deg);
        }

        .card.dimming {
                filter: brightness(0.2);
                /* Dimming effect */
            }

            .card:hover {
                z-index: 10;
                /* Bring the hovered card to the front */
                filter: brightness(1);
                /* Brightness for the hovered card */
            }
        .card-front,
        .card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 15px;
        }

        .card-front img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 15px;
        }

        .card-back {
            transform: rotateY(180deg);
            background: url('/images/background_.png') no-repeat center center;
            background-size: cover;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            color: #fff;
            text-align: center;
            padding: 20px;
            line-height: 1.5;
            transition: background 0.4s ease-in-out, box-shadow 0.4s ease-in-out;
            border-radius: 15px;
        }

        .card:hover .card-back {
            animation: flashingLights 1s infinite alternate ease-in-out;
        }

        @keyframes flashingLights {
            0% {
                filter: brightness(1.2);
            }
            50% {
                filter: brightness(2.5);
            }
            100% {
                filter: brightness(1.2);
            }
        }

        .card-1 {
            top: 100px;
            left: 200px;
            width: 280px;
            height: 480px;
        }

        .card-2 {
            top: 110px;
            left: 600px;
            width: 285px;
            height: 460px;
        }

        .card-3 {
            top: 85px;
            left: 1000px;
            width: 290px;
            height: 520px;
        }

        .card-4 {
            top: 120px;
            left: 1400px;
            width: 320px;
            height: 430px;
        }

        .modal {
            display: none;
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background-color: #1a1a1a;
            padding: 40px;
            color: #fff;
            border-radius: 15px;
            box-shadow: 0 0 20px 10px rgba(255, 255, 255, 0.8);
            z-index: 20;
            max-width: 400px;
            text-align: center;
            animation: fadeIn 0.5s ease-in-out forwards;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translate(-50%, -60%);
            }
            to {
                opacity: 1;
                transform: translate(-50%, -50%);
            }
        }

        .modal-close {
            cursor: pointer;
            color: #f093fb;
            font-weight: bold;
            margin-top: 20px;
        }

        .modal-close:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>
    <div class="cards">
        <div class="card card-1" data-description="Pour ceux qui cherchent un 'ami... avec un petit plus', sans trop de complications !">
            <div class="card-inner">
                <div class="card-front">
                    <img src="/images/joker_neon_converted-removebg-preview.png" alt="Joker">
                </div>
                <div class="card-back">
                    <!-- Arrière-plan par défaut -->
                </div>
            </div>
        </div>

        <div class="card card-2" data-description="Pour ceux qui veulent juste apprendre à se connaître, sans se prendre la tête... et sans passer par la case lit !">
            <div class="card-inner">
                <div class="card-front">
                    <img src="/images/file-removebg-preview.png" alt="Card 2">
                </div>
                <div class="card-back">
                    <!-- Arrière-plan par défaut -->
                </div>
            </div>
        </div>

        <div class="card card-3" data-description="Quand tu veux passer une bonne soirée... sans les discussions du lendemain.">
            <div class="card-inner">
                <div class="card-front">
                    <img src="/images/file__1_-removebg-preview.png" alt="Card 3">
                </div>
                <div class="card-back">
                    <!-- Arrière-plan avec taille personnalisée pour la carte 3 -->
                </div>
            </div>
        </div>

        <div class="card card-4" data-description="Pour les rois et reines du cœur, en quête d'une histoire qui dure et qui compte.">
            <div class="card-inner">
                <div class="card-front">
                    <img src="/images/file__2_-removebg-preview.png" alt="Card 4">
                </div>
                <div class="card-back">
                    <!-- Arrière-plan avec taille personnalisée pour la carte 4 -->
                </div>
            </div>
        </div>
    </div>

    <!-- Modal for card description -->
    <div id="modal" class="modal">
        <p id="modal-description"></p>
        <div class="modal-close" onclick="closeModal()">Fermer</div>
    </div>

    <script>
        // JavaScript for modal handling
        const cards = document.querySelectorAll('.card');
        const modal = document.getElementById('modal');
        const modalDescription = document.getElementById('modal-description');

        cards.forEach(card => {
            card.addEventListener('click', () => {
                const description = card.getAttribute('data-description');
                modalDescription.textContent = description;
                modal.style.display = 'block';
            });
        });

        function closeModal() {
            modal.style.display = 'none';
        }

        // Close modal when clicking outside of it
        window.addEventListener('click', (e) => {
            if (e.target === modal) {
                closeModal();
            }
        });

        cards.forEach(card => {
                card.addEventListener('mouseover', () => {
                    cards.forEach(otherCard => {
                        if (otherCard !== card) {
                            otherCard.classList.add('dimming'); // Add dimming class to non-hovered cards
                        }
                    });
                });

                card.addEventListener('mouseout', () => {
                    cards.forEach(otherCard => {
                        otherCard.classList.remove('dimming'); // Remove dimming class when not hovered
                    });
                });
            });

    </script>
</body>

</html>
<%- include ("../partials/footer.ejs") %>
