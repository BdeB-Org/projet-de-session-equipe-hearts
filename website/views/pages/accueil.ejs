<%- include ("../partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Card Flip Animation</title>
    <style>
      body {
        background-color: #000000;
        font-family: "Orbitron", sans-serif;
        position: relative;
        height: 100vh;
        margin: 0;
        justify-content: center;
        align-items: center;
        transition: filter 0.5s ease-in-out;
      }

      .cards {
        position: relative;
        transition: filter 0.5s ease-in-out;
      }

      .card {
        perspective: 1000px;
        position: absolute;
        transition: filter 0.5s ease-in-out;
        cursor: pointer;
      }

      .card-inner {
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transition: transform 0.6s ease-in-out;
        transform-origin: center;
      }

      .card:hover .card-inner {
        transform: rotateY(180deg);
      }

      .card.dimming {
        filter: brightness(0.2);
      }

      .card:hover {
        z-index: 10;
        filter: brightness(1);
      }

      .card-front,
      .card-back {
        position: absolute;
        width: 100%;
        height: 100%;
        backface-visibility: hidden;
        object-fit: cover;
        object-fit: contain;
        border-radius: 15px;
      }

      .card-front img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-fit: contain;
        border-radius: 15px;
      }

      /* Specific dimensions for each card front */
      .card-1 {
        width: 300px;
        height: 500px;
        top: 100px;
        left: 200px;
      }

      .card-2 {
        width: 280px;
        height: 480px;
        top: 110px;
        left: 600px;
      }

      .card-3 {
        width: 390px;
        height: 590px;
        top: 60px;
        left: 980px;
      }

      .card-4 {
        width: 300px;
        height: 510px;
        top: 100px;
        left: 1400px;
      }

      /* Specific dimensions and positions for each card back */
      .card-back-1 {
        width: 250px;
        height: 350px;
        top: 50px;
        left: 30px;
      }

      .card-back-2 {
        width: 250px;
        height: 350px;
        top: 40px;
      
      }

      .card-back-3 {
        width: 250px;
        height: 350px;
        top: 90px;
        left: 110px;
      }

      .card-back-4 {
        width: 250px;
        height: 350px;
        top: 50px;
        left: 30px;
      }

      .card-back {
        position: absolute;
        backface-visibility: hidden;
        object-fit: cover;
        object-fit: contain;
        border-radius: 15px;
        transform: rotateY(180deg);
        background: url("/images/image.png") no-repeat center center;
        background-size: cover;
        justify-content: center;
        align-items: center;
        font-size: 24px;
        color: #fff;
        text-align: center;
        padding: 20px;
        line-height: 1.5;
        transition: background 0.4s ease-in-out, box-shadow 0.4s ease-in-out;
      }

      .card:hover .card-back {
        animation: flashingLights 1s infinite alternate ease-in-out;
      }

      @keyframes flashingLights {
        0% {
          filter: brightness(1.2);
        }

        50% {
          filter: brightness(2.5);
        }

        100% {
          filter: brightness(1.2);
        }
      }

      .modal {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background-color: #1a1a1a;
        padding: 40px;
        color: #fff;
        border-radius: 15px;
        box-shadow: 0 0 20px 10px rgba(255, 255, 255, 0.8);
        z-index: 20;
        max-width: 400px;
        text-align: center;
        animation: fadeIn 0.5s ease-in-out forwards;
      }

      @keyframes fadeIn {
        from {
          opacity: 0;
          transform: translate(-50%, -60%);
        }

        to {
          opacity: 1;
          transform: translate(-50%, -50%);
        }
      }

      .modal-close {
        cursor: pointer;
        color: #f093fb;
        font-weight: bold;
        margin-top: 20px;
      }

      .modal-close:hover {
        text-decoration: underline;
      }

      #background-video {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
      }
    </style>
  </head>

  <body>
    <video autoplay muted loop id="background-video">
      <source
        src="/images/vecteezy_a-nostalgic-90s-animation-captures-city-lights-and-traffic_49883292.mp4"
        type="video/mp4"
      />
      Your browser does not support the video tag.
    </video>
    <div class="cards">
      <div
        class="card card-1"
        data-description="Pour ceux qui cherchent un 'ami... avec un petit plus', sans trop de complications !"
      >
        <div class="card-inner">
          <div class="card-front">
            <img src="/images/CARD5-JOKER.png" alt="Joker" />
          </div>
          <div class="card-back card-back-1">
            <!-- Custom back for card 1 -->
          </div>
        </div>
      </div>

      <div
        class="card card-2"
        data-description="Pour ceux qui veulent juste apprendre à se connaître, sans se prendre la tête... et sans passer par la case lit !"
      >
        <div class="card-inner">
          <div class="card-front">
            <img src="/images/CARD4-QUEEN.png" alt="Card 2" />
          </div>
          <div class="card-back card-back-2">
            <!-- Custom back for card 2 -->
          </div>
        </div>
      </div>

      <div
        class="card card-3"
        data-description="Quand tu veux passer une bonne soirée... sans les discussions du lendemain."
      >
        <div class="card-inner">
          <div class="card-front">
            <img src="/images/CARD1-ACE.png" alt="Card 3" />
          </div>
          <div class="card-back card-back-3">
            <!-- Custom back for card 3 -->
          </div>
        </div>
      </div>

      <div
        class="card card-4"
        data-description="Pour les rois et reines du cœur, en quête d'une histoire qui dure et qui compte."
      >
        <div class="card-inner">
          <div class="card-front">
            <img src="/images/CARDS3-KING-2.png" alt="Card 4" />
          </div>
          <div class="card-back card-back-4">
            <!-- Custom back for card 4 -->
          </div>
        </div>
      </div>
    </div>

    <!-- Modal for card description -->
    <div id="modal" class="modal">
      <p id="modal-description"></p>
      <div class="modal-close" onclick="closeModal()">Fermer</div>
    </div>

    <script>
      const cards = document.querySelectorAll(".card");
      const modal = document.getElementById("modal");
      const modalDescription = document.getElementById("modal-description");

      cards.forEach((card) => {
        card.addEventListener("click", () => {
          const description = card.getAttribute("data-description");
          modalDescription.textContent = description;
          modal.style.display = "block";
        });
      });

      function closeModal() {
        modal.style.display = "none";
      }

      window.addEventListener("click", (e) => {
        if (e.target === modal) {
          closeModal();
        }
      });

      cards.forEach((card) => {
        card.addEventListener("mouseover", () => {
          cards.forEach((otherCard) => {
            if (otherCard !== card) {
              otherCard.classList.add("dimming");
            }
          });
        });

        card.addEventListener("mouseout", () => {
          cards.forEach((otherCard) => {
            otherCard.classList.remove("dimming");
          });
        });
      });
    </script>
  </body>
</html>
<%- include ("../partials/footer.ejs") %>
