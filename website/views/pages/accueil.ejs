<%- include ("../partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Card Flip Animation</title>
    <style>
        body {
            background-color: #000000;
            position: relative;
            height: 100vh;
            margin: 0;
            justify-content: center;
            align-items: center;
        }

        .cards {
            position: relative;
        }

        .card {
            perspective: 1000px;
            position: absolute;
        }

        .card-inner {
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
            transition: transform 0.6s ease-in-out;
            transform-origin: center; 
        }

        .card:hover .card-inner {
            transform: rotateY(180deg); 
        }

        .card-front,
        .card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            border-radius: 15px;
        }

        .card-front img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 15px;
        }

        .card-back {
            transform: rotateY(180deg);
            background: linear-gradient(135deg, #f093fb, #f5576c); 
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 24px;
            color: #fff;
            text-align: center;
            padding: 20px;
            line-height: 1.5;
            box-shadow: 0px 4px 20px rgba(255, 99, 132, 0.8); 
            transition: background 0.4s ease-in-out;
        }

        .card-back:hover {
            background: linear-gradient(135deg, #f093fb, #f5576c);
        }

        .card-back p {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.5s ease-in-out forwards 0.3s;
        }

        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        
        .card-1 img {
            width: 280px;
            height: 480px;
            border-radius: 15px;
        }

        .card-2 img {
            width: 285px;
            height: 460px;
            border-radius: 15px;
        }

        .card-3 img {
            width: 300px;
            height: 530px;
            border-radius: 15px;
        }

        .card-4 img {
            width: 320px;
            height: 430px;
            border-radius: 15px;
        }

        .card-1 {
            top: 100px;
            left: 200px;
            width: 280px; 
            height: 480px; 
        }

        .card-2 {
            top: 110px;
            left: 600px;
            width: 285px; 
            height: 460px; 
        }

        .card-3 {
            top: 75px;
            left: 1000px;
            width: 300px; 
            height: 530px; 
        }

        .card-4 {
            top: 120px;
            left: 1400px;
            width: 320px; 
            height: 430px; 
        }
    </style>
</head>

<body>
    <div class="cards">
        <div class="card card-1">
            <div class="card-inner">
                <div class="card-front">
                    <img src="/images/joker_neon_converted-removebg-preview.png" alt="Joker">
                </div>
                <div class="card-back">
                    <p>Pour ceux qui cherchent un "ami... avec un petit plus", sans trop de complications !</p>
                </div>
            </div>
        </div>

        <div class="card card-2">
            <div class="card-inner">
                <div class="card-front">
                    <img src="/images/file-removebg-preview.png" alt="Card 2">
                </div>
                <div class="card-back">
                    <p>Pour ceux qui veulent juste apprendre à se connaître, sans se prendre la tête... et sans passer par la case lit !</p>
                </div>
            </div>
        </div>

        <div class="card card-3">
            <div class="card-inner">
                <div class="card-front">
                    <img src="/images/file__1_-removebg-preview.png" alt="Card 3">
                </div>
                <div class="card-back">
                    <p>Quand tu veux passer une bonne soirée... sans les discussions du lendemain.</p>
                </div>
            </div>
        </div>

        <div class="card card-4">
            <div class="card-inner">
                <div class="card-front">
                    <img src="/images/file__2_-removebg-preview.png" alt="Card 4">
                </div>
                <div class="card-back">
                    <p>Pour les rois et reines du cœur, en quête d'une histoire qui dure et qui compte.</p>
                </div>
            </div>
        </div>
    </div>
</body>

</html>
<%- include ("../partials/footer.ejs") %>
