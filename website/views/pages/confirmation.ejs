<%- include("../partials/header.ejs") %>

    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-y: auto;
            /* Ensures the page can scroll vertically */
        }

        body {
            background-color: #0d0d0d;
            color: #ff007f;
            /* Pink theme */
            text-align: center;
            font-family: 'Orbitron', sans-serif;
        }

        .confirmation-container {
            margin: auto;
            max-width: 500px;
            padding: 30px;
            border: 3px solid #00bfff;
            /* Complementary border */
            border-radius: 15px;
            background: rgba(15, 15, 15, 0.9);
            box-shadow: 0 0 25px rgba(255, 0, 127, 0.7);
        }

        h1 {
            font-size: 3em;
            margin-bottom: 20px;
            color: #00ff00;
            /* Bright contrast */
        }

        .details {
            font-size: 1.5em;
            margin: 15px 0;
            color: #00ffff;
            /* Cyan details */
        }

        .highlight {
            color: #ffcc00;
            /* Yellow highlights */
            font-weight: bold;
        }

        .receipt {
            background-color: rgba(255, 255, 255, 0.1);
            padding: 15px;
            border-radius: 10px;
            margin: 20px 0;
            text-align: left;
            color: #ff007f;
            /* Pink text */
        }

        .receipt-item {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
        }

        .button-container {
            margin-top: 20px;
        }

        .back-button {
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            background-color: #ff007f;
            color: white;
            cursor: pointer;
            font-size: 1.2em;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
        }

        .back-button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px #ff007f;
        }

        #background-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
        }

        header {
            position: relative;
            z-index: 1;
        }
    </style>
    <video autoplay muted loop id="background-video">
        <source src="/images/vecteezy_3d-rendering-seamless-loop-motion-of-pink-and-blue-neon-tunnel_6529619.mov"
            type="video/mp4">
        Your browser does not support the video tag.
    </video>

    <div class="confirmation-container">
        <h1>Payment Confirmation</h1>

        <p class="details">Merci, <span class="highlight">
                <%= userDetails.e_prenom %>
                    <%= userDetails.e_nom %>

            </span>!</p>
        <p class="details">Votre abonnement <span class="highlight">
                <%= subscriptionType %>
            </span> a été traité avec succès.</p>
        <p class="details">Payment ID: <span class="highlight">
                <%= paymentId %>
            </span></p>
        <p class="details">Email: <span class="highlight">
                <%= userDetails.e_courriel %>
            </span></p>
        <p class="details">Le reçu a été envoyé à : <span class="highlight">
                <%= confirmationEmail %>
            </span></p>



        <!-- Receipt -->
        <div class="receipt">
            <div class="receipt-item">
                <span><strong>Prix d'abonnement:</strong></span>
                <span>$<%= amount %></span>
            </div>
            <div class="receipt-item">
                <span><strong>TVQ:</strong></span>
                <span>$<%= tvqAmount %></span>
            </div>
            <div class="receipt-item">
                <span><strong>TPS:</strong></span>
                <span>$<%= tpsAmount %></span>
            </div>
            <div class="receipt-item">
                <span><strong>Total:</strong></span>
                <span>$<%= totalAmount %></span>
            </div>
        </div>

        <div class="button-container">
            <button class="back-button" onclick="window.location.href='/';">Retour à l'accueil</button>
        </div>
    </div>

    <%- include("../partials/footer.ejs") %>