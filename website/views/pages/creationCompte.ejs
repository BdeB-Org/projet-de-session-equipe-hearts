<%- include ("../partials/header.ejs") %>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <link rel="stylesheet" href="/creationCompte.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
        <link rel="stylesheet" href="/cyberpunk-css-main/cyberpunk.css">


    </head>

    <body>
        <script src="https://cdn.jsdelivr.net/npm/particles.js"></script>


        <div id="particles-js"></div>

        <div class="container-wrapper">

            <div class="container" id="container">
                <div class="form-container sign-up">
                    <form onsubmit="redirectInscription(event)">
                        <h1>Créer un compte</h1>
                        <div class="social-icons">
                            <a href="/auth/google" class="icons"><i class="fa-brands fa-google"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-facebook"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-apple"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                        <span>ou utiliser votre courriel...</span>

                        <div class="cyber-input ac-purple fg-yellow">
                            <input type="email" id="courriel_insc" placeholder=" courriel" required>

                        </div>
                        <div class="cyber-input ac-purple fg-yellow">
                            <input type="password" id="mdp_insc" placeholder=" mot de passe" required>

                        </div>
                        <div class="cyber-input ac-purple fg-yellow">
                            <input type="password" id="verif-mdp_insc" placeholder=" vérifiez mot de passe"
                                required>

                        </div>






                        <button type="submit" class="hidden cyber-button bg-yellow fg-white">
                            S'inscrire
                            <span class="glitchtext">S'inscrire</span>
                            <!-- <span class="tag">225</span> -->
                        </button>
                    </form>




                </div>


                <div class="form-container sign-in">
                    <form method="post" action="/event/connect">
                        <h1>Se Connecter</h1>
                        <div class="social-icons">
                            <a href="/auth/google" class="icons"><i class="fa-brands fa-google"></i></a>
                            <a href="/auth/facebook" class="icons"><i class="fa-brands fa-facebook"></i></a>
                            <a href="/auth/apple" class="icons"><i class="fa-brands fa-apple"></i></a>
                            <a href="/auth/twitter" class="icons"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                        <span>ou utiliser votre courriel...</span>

                        <div class="cyber-input ac-purple fg-yellow">
                            <input type="email" id="courriel" name="email" placeholder=" courriel" required>

                        </div>

                        <div class="cyber-input ac-purple fg-yellow">
                            <input type="password" id="mdp" name="password" placeholder=" mot de passe" required>
                        </div>


                        <a href="#" class="mdp_button">Mot de passe oublié?</a>


                        <button type="submit" class="cyber-button bg-yellow fg-white">
                            SE CONNECTER
                            <span class="glitchtext">Se Connecter</span>
                        </button>



                    </form>
                </div>


                <div class="toggle-container">
                    <div class="toggle">
                        <div class="toggle-panel toggle-left">
                            <h1>Bon retour!</h1>
                            <p>Veuillez vous inscrire pour <br> sauvegarder vos informations</p>

                            <button class="cyber-button bg-yellow fg-black" id="login">
                                SE CONNECTER
                                <span class="glitchtext">Se Connecter</span>
                            </button>
                        </div>
                        <div class="toggle-panel toggle-right">
                            <h1>Bonjour, nouvel ami!</h1>
                            <p>Pige une carte, trouve ton destin.</p>
                            <button class="hidden cyber-button bg-yellow fg-black" id="register">
                                S'inscrire
                                <span class="glitchtext">S'inscrire</span>
                            </button>



                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="/js/creationCompte.js"></script>

    </body>

    </html>
    <%- include ("../partials/footer.ejs") %>