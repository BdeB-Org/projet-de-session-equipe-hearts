<%- include ("../partials/header.ejs") %>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Document</title>
        <link rel="stylesheet" href="/creationCompte.css">
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    </head>

    <body>
        <div class="container-wrapper">

            <div class="container" id="container">
                <div class="form-container sign-up">
                    <form onsubmit="redirectInscription(event)">
                        <h1>Créer un compte</h1>
                        <div class="social-icons">
                            <a href="#" class="icons"><i class="fa-brands fa-google"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-facebook"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-apple"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                        <span>ou utiliser votre courriel...</span>

                        <input type="email" id="courriel_insc" placeholder="Courriel" required>
                        <span class="message-erreur" id="erreur-email"></span>

                        <input type="password" id="mdp_insc" placeholder="Mot de passe" required>
                        <span class="message-erreur" id="erreur-mdp"></span>

                        <input type="password" id="verif-mdp_insc" placeholder="Vérifiez votre mot de passe" required>
                        <span class="message-erreur" id="erreur-mdp-verif"></span>

                        <button type="submit">S'inscrire</button>
                    </form>




                </div>


                <div class="form-container sign-in">
                    <form method="post" action="/event/connect">
                        <h1>Se Connecter</h1>
                        <div class="social-icons">
                            <a href="#" class="icons"><i class="fa-brands fa-google"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-facebook"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-apple"></i></a>
                            <a href="#" class="icons"><i class="fa-brands fa-twitter"></i></a>
                        </div>
                        <span>ou utiliser votre courriel...</span>
                        <input type="email" id="courriel" name="email" placeholder="Courriel" required>
                        <input type="password" id="mdp" name="password" placeholder="Mot de passe" required>
                        <a href="#" class="mdp_button">Mot de passe oublié?</a>
                        <button type="submit">SE CONNECTER</button>

                    </form>
                </div>


                <div class="toggle-container">
                    <div class="toggle">
                        <div class="toggle-panel toggle-left">
                            <h1>Bon retour!</h1>
                            <p>Veuillez vous inscrire pour <br> sauvegarder vos informations</p>
                            <button class="hidden" id="login">SE CONNECTER</button>
                        </div>
                        <div class="toggle-panel toggle-right">
                            <h1>Bonjour, nouvel ami!</h1>
                            <p>Pige une carte, trouve ton joker.</p>
                            <button class="hidden" id="register">S'inscrire</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script src="/js/creationCompte.js"></script>
    </body>

    </html>
    <%- include ("../partials/footer.ejs") %>