<%- include ("../partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hearts</title>
    <link rel="stylesheet" href="/inscription.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
</head>

<body>
    <div class="form_inscription">
        <form id="myForm" class="orbitron-font">
            <!-- Phone Number (with code verification) -->
            <div class="step label" id="step-1">
                <input type="tel" placeholder="Numéro Format: 514-235-7369" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" required>
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- First Name -->
            <div class="step" id="step-2">
                <input type="text" placeholder="Prénom" required>
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- Last Name -->
            <div class="step" id="step-3">
                <input type="text" placeholder="Nom de famille">
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- Birthdate -->
            <div class="step" id="step-4">
                <input type="date" placeholder="Date de naissance" required>
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- Gender (M/W) -->
            <div class="step" id="step-5">
                <select required>
                    <option value="" disabled selected>Genre</option>
                    <option value="H">Homme</option>
                    <option value="F">Femme</option>
                    <option value="O">Autre</option>
                </select>
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- Sexual Orientation -->
            <div class="step" id="step-6">
                <select required>
                    <option value="" disabled selected>Orientation sexuelle (hétéro, gay, lesbienne, bi)</option>
                    <option value="hétéro">Hétérosexuel</option>
                    <option value="gay">Gay</option>
                    <option value="lesbienne">Lesbienne</option>
                    <option value="bi">Bisexuel</option>
                </select>
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- Looking for? (CARDS) -->
            <div class="step" id="step-7">
                <input type="text" placeholder="Que cherchez-vous? (Cartes)" required>
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- What do you like? -->
            <div class="step" id="step-8">
                <input type="text" placeholder="Qu'est-ce que vous aimez?" required>
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- Pictures (2-6) -->
            <div class="step" id="step-9">
                <input type="file" accept="image/*" multiple placeholder="Photos (2-6)" required>
                <button type="button" class="next-button">Next</button>
            </div>

            <!-- Submit button -->
            <div class="step" id="step-10">
                <input type="submit" value="Soumettre">
            </div>
        </form>
    </div>

    <script src="/js/inscription.js"></script>
</body>

</html>
<%- include ("../partials/footer.ejs") %>
