<%- include ("../partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hearts</title>
    <link rel="stylesheet" href="/inscription.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
  </head>

  <body>
    <div class="chat-container">
      <div class="input-container">
        <input
          type="text"
          id="userInput"
          class="input-field"
          placeholder="Enter your response..."
        />
        <button class="send-button">&#x27A4;</button>
      </div>
    </div>

    <div class="image-selection-container" style="display: none">
      <div class="image-section">
        <label for="radioHomme">
          <img
            src="/images/swiper.png"
            class="icon flicker"
            id="imageHomme"
            alt="Homme"
          />
        </label>
        <input
          type="radio"
          name="selectedImage"
          id="radioHomme"
          value="Homme"
          hidden
          required
        />
      </div>

      <div class="image-section">
        <label for="radioFemme">
          <img
            src="/images/swiper2.png"
            class="icon flicker"
            id="imageFemme"
            alt="Femme"
          />
        </label>
        <input
          type="radio"
          name="selectedImage"
          id="radioFemme"
          value="Femme"
          hidden
          required
        />
      </div>
    </div>

    <form
      id="myForm"
      action="/event/inscription"
      method="POST"
      enctype="multipart/form-data"
      style="display: none"
    >
      <input type="hidden" id="selected-card" name="selectedCard" value="" />
      <input type="hidden" id="selected-likes" name="selectedLikes" value="" />
      <input
        type="hidden"
        id="selectedSexualite"
        name="selectedSexualite"
        value=""
      />
      <input
        type="radio"
        name="selectedImage"
        id="radioHomme"
        value="Homme"
        hidden
        required
      />
      <input
        type="radio"
        name="selectedImage"
        id="radioFemme"
        value="Femme"
        hidden
        required
      />
      <input type="email" id="email" name="email" required />
      <input type="password" id="password" name="password" required />
      <input type="password" id="verify-password" required />
      <input
        type="tel"
        id="phone"
        name="phone"
        pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}"
        required
      />
      <input type="text" id="first-name" name="firstName" required />
      <input type="text" id="last-name" name="lastName" required />
      <input type="date" id="birthdate" name="birthdate" required />
      <select id="gender" name="gender" required>
        <option value="" disabled selected>Genre</option>
        <option value="H">Homme</option>
        <option value="F">Femme</option>
        <option value="O">Autre</option>
      </select>
      <input type="file" id="photos" name="photo" accept="image/*" required />
    </form>

    <script src="/js/inscription.js"></script>
  </body>
  <%- include ("../partials/footer.ejs") %>
</html>
