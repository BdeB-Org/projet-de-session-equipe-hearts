<%- include ("../partials/header.ejs") %>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hearts</title>
    <link rel="stylesheet" href="/inscription.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">
</head>

<body>
    <div class="chat-container">
        <!-- Input field and send button at the bottom -->
        <div class="input-container">
            <input type="text" id="userInput" class="input-field" placeholder="Enter your response...">
            <button class="send-button">&#x27A4;</button>
        </div>
    </div>
    
    

    <!-- Hidden form containing all fields for submission -->
    <form id="myForm" action="/event/inscription" method="POST" enctype="multipart/form-data" style="display:none;">
        <!-- Hidden form fields -->
        <input type="hidden" id="selected-card" name="selectedCard" value="">
        <input type="hidden" id="selected-likes" name="selectedLikes" value="">
        <input type="hidden" id="selectedSexualite" name="selectedSexualite" value="">
        <input type="radio" name="selectedImage" id="radioHomme" value="Homme" hidden required>
        <input type="radio" name="selectedImage" id="radioFemme" value="Femme" hidden required>

        <!-- All form fields as hidden inputs -->
        <input type="email" id="email" name="email" required>
        <input type="password" id="password" name="password" required>
        <input type="password" id="verify-password" required>
        <input type="tel" id="phone" name="phone" pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" required>
        <input type="text" id="first-name" name="firstName" required>
        <input type="text" id="last-name" name="lastName" required>
        <input type="date" id="birthdate" name="birthdate" required>
        <select id="gender" name="gender" required>
            <option value="" disabled selected>Genre</option>
            <option value="H">Homme</option>
            <option value="F">Femme</option>
            <option value="O">Autre</option>
        </select>
        <input type="file" id="photos" name="photo" accept="image/*" required>
    </form>

    <script src="/js/inscription.js"></script>
</body>
<%- include ("../partials/footer.ejs") %>
