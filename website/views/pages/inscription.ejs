<%- include ("../partials/header.ejs") %>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Hearts</title>
        <link rel="stylesheet" href="/inscription.css">
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" rel="stylesheet">

        <svg xmlns="http://www.w3.org/2000/svg" version="1.1">
            <defs>
                <!-- White Glow Effect (for Ace and Joker) -->
                <filter id="glow-effect" x="-50%" y="-50%" width="200%" height="200%">
                    <feFlood flood-color="white" result="flood"></feFlood>
                    <feComposite in="flood" in2="SourceGraphic" operator="in" result="mask"></feComposite>
                    <feGaussianBlur in="mask" stdDeviation="6" result="blurred"></feGaussianBlur>
                    <feMerge>
                        <feMergeNode in="blurred"></feMergeNode>
                        <feMergeNode in="SourceGraphic"></feMergeNode>
                    </feMerge>
                </filter>
        
                <!-- Pink Glow Effect (for Queen and King) -->
                <filter id="pink-glow-effect" x="-50%" y="-50%" width="200%" height="200%">
                    <feFlood flood-color="#FF79A1" result="flood"></feFlood>
                    <feComposite in="flood" in2="SourceGraphic" operator="in" result="mask"></feComposite>
                    <feGaussianBlur in="mask" stdDeviation="6" result="blurred"></feGaussianBlur>
                    <feMerge>
                        <feMergeNode in="blurred"></feMergeNode>
                        <feMergeNode in="SourceGraphic"></feMergeNode>
                    </feMerge>
                </filter>
            </defs>
        </svg>
        
    </head>

    <body>
        <main class="form_inscription">
            <div class="grid-container">
                <!-- First Image -->
                <div class="image-section image1">
                    <img src="/images/swiper.png">
                </div>
                <!-- Second Image -->
                <div class="image-section image2">
                    <img src="/images/swiper2.png">
                </div>

                <!-- Form split into two columns -->
                <form id="myForm" class="orbitron-font form-grid" action="/event/inscription" method="POST"
                    enctype="multipart/form-data">
                    <!-- Left Column of Form -->
                    <div class="form-column">
                        <!-- Email -->
                        <div class="step" id="step-0">
                            <input type="email" id="email" name="email" placeholder="Adresse e-mail" required>
                        </div>

                        <!-- Password -->
                        <div class="step" id="step-1">
                            <input type="password" id="password" name="password" placeholder="Mot de passe"
                                 required>
                                <!-- minlength -->
                        </div>

                        <!-- Verify Password -->
                        <div class="step" id="step-2">
                            <input type="password" id="verify-password" placeholder="Vérifiez le mot de passe"
                                 required>
                        </div>

                        <!-- Phone Number -->
                        <div class="step" id="step-3">
                            <input type="tel" id="phone" name="phone" placeholder="Numéro: 514-235-7369"
                                pattern="[0-9]{3}-[0-9]{3}-[0-9]{4}" required>
                        </div>

                        <!-- First Name -->
                        <div class="step" id="step-4">
                            <input type="text" id="first-name" name="firstName" placeholder="Prénom (Affiché)" required>
                        </div>

                        <!-- Last Name -->
                        <div class="step" id="step-5">
                            <input type="text" id="last-name" name="lastName" placeholder="Nom" required>
                        </div>
                    </div>

                    <!-- Right Column of Form -->
                    <div class="form-column">
                        <!-- Birthdate -->
                        <div class="step" id="step-6">
                            <input type="date" id="birthdate" name="birthdate" required>
                        </div>

                        <!-- Gender -->
                        <div class="step" id="step-7">
                            <select id="gender" name="gender" required>
                                <option value="" disabled selected>Genre</option>
                                <option value="H">Homme</option>
                                <option value="F">Femme</option>
                                <option value="O">Autre</option>
                            </select>
                        </div>

                        <!-- Looking for? (CARDS) -->
                        <p>Que cherchez-vous?</p>
                        <div class="icon-container">
                            <label for="ace"><img src="/images/ace.png" class="icon" id="ace" alt="Ace"></label>
                            <label for="joker"><img src="/images/joker.png" class="icon" id="joker" alt="Joker"></label>
                            <label for="queen"><img src="/images/queen.png" class="icon" id="queen" alt="Queen"></label>
                            <label for="king"><img src="/images/king.png" class="icon" id="king" alt="King"></label>
                        </div>


                        <!-- Likes -->
                        <div class="step" id="step-10">
                            <p>Qu'est-ce que vous aimez?</p>
                            <button type="button" id="pick-options-btn">Choisir options</button>
                            <div id="selected-options"></div>
                        </div>
                        <div id="options-modal" class="modal">
                            <div class="modal-content">
                                <span class="close-btn">&times;</span>
                                <h3>Choose Your Interests</h3>
                                <div class="scrollable-options">
                                    <label>
                                        <input type="checkbox" name="interests" value="musique"> Musique
                                    </label>
                                    <label>
                                        <input type="checkbox" name="interests" value="cinema"> Cinéma
                                    </label>
                                    <label>
                                        <input type="checkbox" name="interests" value="voyages"> Voyages
                                    </label>
                                    <label>
                                        <input type="checkbox" name="interests" value="sport"> Sport
                                    </label>
                                    <label>
                                        <input type="checkbox" name="interests" value="lecture"> Lecture
                                    </label>
                                    <label>
                                        <input type="checkbox" name="interests" value="cuisine"> Cuisine
                                    </label>
                                    <!-- Add more options as needed -->
                                </div>
                                <button type="button" id="save-options-btn">Save</button>
                            </div>
                        </div>

                        <!-- Photos -->
                        <div class="step" id="step-11">
                            <input type="file" id="photos" name="photo" accept="image/*" required>
                        </div>
                    </div>

                    <!-- Submit Button -->
                    <div class="submit-button-container">
                        <button type="submit" class="next-button">Soumettre</button>
                    </div>
                </form>
            </div>
        </main>

        <script src="/js/inscription.js"></script>
    </body>

    </html>
    <%- include ("../partials/footer.ejs") %>