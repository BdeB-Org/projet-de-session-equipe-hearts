<%- include("../partials/header.ejs") %>

    <style>
        /* Define colors */
        body {
            background-color: #0d0d0d;
            color: #ff007f;
            text-align: center;
            font-family: "Orbitron", sans-serif;
            overflow: hidden;
        }

        .payment-container {
            margin: auto;
            max-width: 400px;
            padding: 20px;
            border: 2px solid #ff007f;
            border-radius: 10px;
            background: rgba(10, 10, 10, 0.9);
            box-shadow: 0 0 20px rgba(255, 0, 127, 0.5);
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 0 0 5px #ff007f;
        }

        p {
            font-size: 1.2em;
            margin-bottom: 20px;
            text-shadow: 0 0 5px #ff007f;

        }

        label {
            display: block;
            margin-bottom: 5px;
            font-size: 1.1em;
            color: #ff007f;
            /* Neon blue */
        }

        input[type="number"],
        input[type="text"] {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 2px solid transparent;
            border-radius: 5px;
            font-size: 1em;
            text-align: center;
            box-shadow: 0 0 5px rgba(255, 0, 127, 0.5);
        }

        .button {
            background-color: #ff007f;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 20px;
            font-size: 1.2em;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
        }

        .button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px #ff007f;
        }

        /* MODAL */
        .modal {
            display: none;
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.8);
        }

        .modal-content {
            background-color: #1e1e1e;
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 0 40px rgba(255, 0, 127, 0.5);
            width: 90%;
            max-width: 500px;
            margin: auto;
            transition: all 0.3s ease;
        }

        input[type="number"],
        input[type="text"] {
            width: 100%;
            padding: 15px;
            margin-bottom: 20px;
            border: 2px solid #ff007f;
            border-radius: 5px;
            font-size: 1em;
            text-align: center;
            background-color: #2c2c2c;
            color: #fff;
            transition: border-color 0.3s;
        }

        input[type="number"]:focus,
        input[type="text"]:focus {
            border-color: #ff007f;
            outline: none;
        }

        .submit-button {
            background-color: #ff007f;
            color: white;
            padding: 15px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1.2em;
            transition: background-color 0.3s, transform 0.3s;
            width: 100%;
        }

        .submit-button:hover {
            background-color: #fbff00a7;
            transform: scale(1.05);
        }

        label {
            margin-bottom: 10px;
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

        .receipt {
            background-color: rgba(255, 255, 0, 0.1);
            padding: 10px;
            border-radius: 5px;
            margin: 20px 0;
            text-align: left;
        }

        .receipt-item {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
        }

        #card-container {
            margin: 20px 0;
            padding: 20px;
            border: 1px solid #f6ff00;
            border-radius: 5px;
            background-color: rgb(255, 255, 255);
            box-shadow: 0 0 15px rgba(255, 247, 13, 0.3);
        }

        input[type="text"] {
            width: calc(100% - 20px);
            padding: 10px;
            margin-bottom: 15px;
            border: 2px solid #ff007f;
            border-radius: 5px;
            background-color: #2c2c2c;
            color: #fff;
        }

        input[type="text"]:focus {
            border-color: #ff007f;
            outline: none;
        }

        #background-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
        }

        #card-container {
            display: flex;
            flex-direction: column;
            margin-bottom: 15px;

        }

        #cardholder-name {
            border: 2px solid #ff69b4;
            border-radius: 8px;
            padding: 10px;
            font-size: 16px;
            outline: none;
            transition: border-color 0.3s;
        }

        #cardholder-name:focus {
            border-color: #ff1493;
        }

        label {
            font-weight: bold;
            margin-bottom: 5px;
            color: #ff1493;
        }
    </style>

    <body>
        <video autoplay muted loop id="background-video">
            <source src="/images/vecteezy_abstract-cyberpunk-animated-background_4846470.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>

        <div class="payment-container">
            <h1>Payer Votre Abonnement</h1>
            <p>Merci de choisir votre plan.</p>

            <!-- Receipt -->
            <div class="receipt">
                <div class="receipt-item">
                    <span><strong>Name of Subscription:</strong></span>
                    <span id="subscription-name"></span>
                </div>
                <div class="receipt-item">
                    <span><strong>Initial Amount:</strong></span>
                    <span id="initial-amount"></span> <!-- Ensure this ID matches -->
                </div>
                <div class="receipt-item">
                    <span><strong>TVQ:</strong></span>
                    <span id="tvq-amount"></span> <!-- Ensure this ID matches -->
                </div>
                <div class="receipt-item">
                    <span><strong>TPS:</strong></span>
                    <span id="tps-amount"></span> <!-- Ensure this ID matches -->
                </div>
                <div class="receipt-item">
                    <span><strong>Total:</strong></span>
                    <span id="total-amount"></span> <!-- Ensure this ID matches -->
                </div>
            </div>
            <form id="payment-form">
                <div style="display: none;">
                    <label for="amount">Montant ($):</label>
                    <input type="number" id="amount" name="amount" required readonly>
                </div>
                <button type="submit" class="button">Payer</button>
            </form>
        </div>

        <!-- MODAL -->
        <div id="card-modal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal()">&times;</span>
                <h2 style="color: #ff007f;">Saisir les détails de la carte</h2>
                <div id="card-container">
                    <label for="cardholder-name" style="font-size: 0.9em;">Courriel de confirmation:</label>
                    <input type="email" id="cardholder-name" name="confirmationEmail" placeholder="exemple@mail.com"
                        required>
                </div>

                <button class="submit-button" id="submit-button">Submit Payment</button>
            </div>
        </div>
        <div id="loading-modal" class="modal">
            <div class="modal-content">
                <h2 style="color: #ff007f;">Traitement du paiement...</h2>
                <p>Merci de patienter pendant que nous traitons votre paiement.</p>
            </div>
        </div>

        <script src="https://sandbox.web.squarecdn.com/v1/square.js"></script>
        <script>
            const urlParams = new URLSearchParams(window.location.search);
            const amount = parseFloat(urlParams.get('amount')) || 0;
            const subscriptionName = urlParams.get('subscriptionType');
            document.getElementById('subscription-name').innerText = subscriptionName;
            const confirmationEmail = document.getElementById('cardholder-name').value;

            console.log('Captured Email:', confirmationEmail);
            if (amount) {
                document.getElementById('initial-amount').innerText = `$${amount.toFixed(2)}`;

                const tvqRate = 0.09975;
                const tpsRate = 0.05;

                const tvqAmount = amount * tvqRate;
                const tpsAmount = amount * tpsRate;
                const totalAmount = amount + tvqAmount + tpsAmount;

                document.getElementById('tvq-amount').innerText = `$${tvqAmount.toFixed(2)}`;
                document.getElementById('tps-amount').innerText = `$${tpsAmount.toFixed(2)}`;
                document.getElementById('total-amount').innerText = `$${totalAmount.toFixed(2)}`;
                document.getElementById('total-amount').value = totalAmount.toFixed(2);

                document.getElementById('amount').value = totalAmount.toFixed(2);
            }


            const modal = document.getElementById("card-modal");
            const loadingModal = document.getElementById("loading-modal");

            document.getElementById('payment-form').addEventListener('submit', function (event) {
                event.preventDefault();
                modal.style.display = "block"; // Show the modal
            });

            function closeModal() {
                modal.style.display = "none"; // Close the modal
            }

            function showLoadingModal() {
                loadingModal.style.display = "block"; // Show loading modal
            }

            function hideLoadingModal() {
                loadingModal.style.display = "none"; // Hide loading modal
            }


            const payments = Square.payments('sandbox-sq0idb-shiPBy7gPbmt9DCjtx3jYw'); // Replace with your Square Application ID

            async function initializeCard() {
                const card = await payments.card();
                await card.attach('#card-container');
                zipCode: false

                document.getElementById('submit-button').addEventListener('click', async () => {
                    const result = await card.tokenize();
                    if (result.status === 'OK') {
                        const sourceId = result.token;
                        const amount = document.getElementById('amount').value;
                        const subscriptionType = document.getElementById('subscription-name').innerText;
                        const confirmationEmail = document.getElementById('cardholder-name').value;

                        const totalAmountInCents = amount * 100;

                        console.log('Source ID:', sourceId);
                        console.log('Total Amount (Cents):', totalAmountInCents);
                        console.log('Subscription Type:', subscriptionType);
                        console.log('Confirmation Email:', confirmationEmail);

                        showLoadingModal();

                        const response = await fetch('/event/payment', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ sourceId, amount: totalAmountInCents, subscriptionType, confirmationEmail })
                        });

                        const paymentResult = await response.json();

                        hideLoadingModal();


                        if (paymentResult.redirect) {
                            modal.style.display = "none";

                            window.location.href = paymentResult.redirect;
                        } else {
                            alert('Payment failed: ' + paymentResult.message);
                        }
                    } else {
                        alert('Tokenization failed: ' + result.errors[0].message);
                    }
                });
            }

            initializeCard();
        </script>


        <%- include("../partials/footer.ejs") %>