<%- include("../partials/header.ejs") %>

    <style>
        /* Define colors */
        body {
            background-color: #0d0d0d;
            /* Dark background */
            color: #ff007f;
            /* Bright pink */
            text-align: center;
            font-family: "Orbitron", sans-serif;
            overflow: hidden;
        }

        .payment-container {
            margin: auto;
            max-width: 400px;
            padding: 20px;
            border: 2px solid #00bfff;
            /* Neon blue */
            border-radius: 10px;
            background: rgba(10, 10, 10, 0.9);
            box-shadow: 0 0 20px rgba(255, 0, 127, 0.5);
            /* Semi-transparent pink shadow */
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 0 0 5px #00bfff;
            /* Neon blue */
        }

        p {
            font-size: 1.2em;
            margin-bottom: 20px;
            text-shadow: 0 0 5px #00bfff;
            /* Neon blue */
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-size: 1.1em;
            color: #00bfff;
            /* Neon blue */
        }

        input[type="number"],
        input[type="text"] {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 2px solid transparent;
            border-radius: 5px;
            background-color: #ffff00;
            /* Yellow */
            color: white;
            font-size: 1em;
            text-align: center;
            box-shadow: 0 0 5px rgba(255, 0, 127, 0.5);
        }

        .button {
            background-color: #ff007f;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 20px;
            font-size: 1.2em;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
        }

        .button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px #ff007f;
        }

        /* MODAL */
        .modal {
            display: none;
            /* Hidden by default */
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.8);
            /* Black w/ opacity */
        }

        .modal-content {
            background-color: #1e1e1e;
            /* Darker background for the modal */
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
            width: 90%;
            max-width: 500px;
            margin: auto;
        }

        .submit-button {
            background-color: #ff007f;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1.2em;
            transition: background-color 0.3s, transform 0.3s;
            width: 100%;
        }

        .submit-button:hover {
            background-color: #fbff00a7;
            transform: scale(1.05);
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

        .receipt {
            background-color: rgba(255, 255, 0, 0.1);
            padding: 10px;
            border-radius: 5px;
            margin: 20px 0;
            text-align: left;
        }

        .receipt-item {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
        }
    </style>

    <body>
        <div class="payment-container">
            <h1>Payer Votre Abonnement</h1>
            <p>Merci de choisir votre plan.</p>

            <!-- Receipt -->
            <div class="receipt">
                <div class="receipt-item">
                    <span><strong>Name of Subscription:</strong></span>
                    <span id="subscription-name"></span>
                </div>
                <div class="receipt-item">
                    <span><strong>Initial Amount:</strong></span>
                    <span id="initial-amount"></span>
                </div>
                <div class="receipt-item">
                    <span><strong>TVQ (Quebec Tax):</strong></span>
                    <span id="tvq-amount"></span>
                </div>
                <div class="receipt-item">
                    <span><strong>TPS:</strong></span>
                    <span id="tps-amount"></span>
                </div>
                <div class="receipt-item">
                    <span><strong>Total:</strong></span>
                    <span id="total-amount"></span>
                </div>
            </div>

            <form id="payment-form">
                <div>
                    <label for="amount">Montant ($):</label>
                    <input type="number" id="amount" name="amount" required readonly>
                </div>
                <button type="submit" class="button">Payer</button>
            </form>
        </div>

        <!-- MODAL -->
        <div id="card-modal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal()">&times;</span>
                <h2 style="color: #ff007f;">Enter Card Details</h2>
                <div id="card-container"></div>
                <button class="submit-button" id="submit-button">Submit Payment</button>
            </div>
        </div>

        <script src="https://sandbox.web.squarecdn.com/v1/square.js"></script>
        <script>
            const urlParams = new URLSearchParams(window.location.search);
            const amount = parseFloat(urlParams.get('amount')) || 0;
            const subscriptionName = urlParams.get('subscriptionType');
            document.getElementById('subscription-name').innerText = subscriptionName;

            if (amount) {
                document.getElementById('amount').value = amount;
                document.getElementById('initial-amount').innerText = `$${amount.toFixed(2)}`;

                const tvqRate = 0.09975;
                const tpsRate = 0.05;

                const tvqAmount = amount * tvqRate;
                const tpsAmount = amount * tpsRate;
                const totalAmount = amount + tvqAmount + tpsAmount;

                document.getElementById('tvq-amount').innerText = `$${tvqAmount.toFixed(2)}`;
                document.getElementById('tps-amount').innerText = `$${tpsAmount.toFixed(2)}`;
                document.getElementById('total-amount').innerText = `$${totalAmount.toFixed(2)}`;

                document.getElementById('amount').value = totalAmount.toFixed(2);
            }

            const modal = document.getElementById("card-modal");

            document.getElementById('payment-form').addEventListener('submit', function (event) {
                event.preventDefault();
                modal.style.display = "block"; // Show the modal
            });

            function closeModal() {
                modal.style.display = "none"; // Close the modal
            }

            const payments = Square.payments('sandbox-sq0idb-shiPBy7gPbmt9DCjtx3jYw'); // Replace with your Square Application ID

            async function initializeCard() {
                const card = await payments.card();
                await card.attach('#card-container');

                document.getElementById('submit-button').addEventListener('click', async () => {
                    const result = await card.tokenize();
                    if (result.status === 'OK') {
                        const sourceId = result.token;
                        const amount = document.getElementById('amount').value;
                        const subscriptionType = document.getElementById('subscription-name').innerText;

                        const totalAmountInCents = amount * 100;

                        console.log('Source ID:', sourceId);
                        console.log('Total Amount (Cents):', totalAmountInCents);
                        console.log('Subscription Type:', subscriptionType);

                        const response = await fetch('/event/payment', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ sourceId, amount: totalAmountInCents, subscriptionType })
                        });

                        const paymentResult = await response.json();

                        // Handle redirection after payment success
                        if (paymentResult.redirect) {
                            // Close the modal after payment
                            modal.style.display = "none";
                            // Redirect to the confirmation page
                            window.location.href = paymentResult.redirect;
                        } else {
                            alert('Payment failed: ' + paymentResult.message);
                        }
                    } else {
                        alert('Tokenization failed: ' + result.errors[0].message);
                    }
                });
            }

            initializeCard();
        </script>


        <%- include("../partials/footer.ejs") %>