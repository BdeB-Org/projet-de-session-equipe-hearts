<%- include("../partials/header.ejs") %>

    <style>
        /* Define colors */
        body {
            background-color: #0d0d0d;
            /* Dark background */
            color: #ff007f;
            /* Bright pink */
            text-align: center;
            font-family: 'Orbitron', sans-serif;
            overflow: hidden;
        }

        .payment-container {
            margin: auto;
            max-width: 400px;
            padding: 20px;
            border: 2px solid #00bfff;
            /* Neon blue */
            border-radius: 10px;
            background: rgba(10, 10, 10, 0.9);
            box-shadow: 0 0 20px rgba(255, 0, 127, 0.5);
            /* Semi-transparent pink shadow */
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 0 0 5px #00bfff;
            /* Neon blue */
        }

        p {
            font-size: 1.2em;
            margin-bottom: 20px;
            text-shadow: 0 0 5px #00bfff;
            /* Neon blue */
        }

        label {
            display: block;
            margin-bottom: 5px;
            font-size: 1.1em;
            color: #00bfff;
            /* Neon blue */
        }

        input[type="number"],
        input[type="text"] {
            width: 100%;
            padding: 10px;
            margin-bottom: 20px;
            border: 2px solid transparent;
            /* Removed the green border */
            border-radius: 5px;
            background-color: #ffff00;
            /* Yellow */
            color: white;
            font-size: 1em;
            text-align: center;
            box-shadow: 0 0 5px rgba(255, 0, 127, 0.5);
        }

        input[readonly] {
            background-color: #444;
            cursor: not-allowed;
        }

        .button {
            background-color: #ff007f;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 20px;
            font-size: 1.2em;
            transition: transform 0.3s, box-shadow 0.3s;
            box-shadow: 0 0 10px rgba(255, 0, 127, 0.5);
        }

        .button:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px #ff007f;
        }

        /* 
        MODAL
        */
        .modal {
            display: none;
            /* Hidden by default */
            position: fixed;
            z-index: 1;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0, 0, 0, 0.8);
            /* Black w/ opacity */
        }

        .modal-content {
            background-color: #1e1e1e;
            /* Darker background for the modal */
            border-radius: 10px;
            padding: 20px;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.5);
            width: 90%;
            max-width: 500px;
            margin: auto;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            color: #ff007f;
            margin-bottom: 5px;
        }

        .form-group input {
            width: 100%;
            padding: 10px;
            border: 2px solid #f7dc6f;
            border-radius: 5px;
            background-color: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .submit-button {
            background-color: #ff007f;
            /* Bright pink */
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1.2em;
            transition: background-color 0.3s, transform 0.3s;
            width: 100%;
            /* Make the button full-width */
        }

        .submit-button:hover {
            background-color: #00ff00;
            /* Neon green on hover */
            transform: scale(1.05);
            /* Slightly enlarge on hover */
        }

        .close {
            color: #aaa;
            float: right;
            font-size: 28px;
            font-weight: bold;
        }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

        /* Receipt styles */
        .receipt {
            background-color: rgba(255, 255, 0, 0.1);
            /* Light yellow background */
            padding: 10px;
            border-radius: 5px;
            margin: 20px 0;
            text-align: left;
        }

        .receipt-item {
            display: flex;
            justify-content: space-between;
            padding: 5px 0;
        }
    </style>

    <body>
        <div class="payment-container">
            <h1>Payer Votre Abonnement</h1>
            <p>Merci de choisir votre plan.</p>

            <!-- Display Receipt Information -->
            <div class="receipt">
                <div class="receipt-item">
                    <span><strong>Name of Subscription:</strong></span>
                    <span id="subscription-name">Your Subscription</span>
                </div>
                <div class="receipt-item">
                    <span><strong>Initial Amount:</strong></span>
                    <span id="initial-amount"></span>
                </div>
                <div class="receipt-item">
                    <span><strong>TVQ (Quebec Tax):</strong></span>
                    <span id="tvq-amount"></span>
                </div>
                <div class="receipt-item">
                    <span><strong>TPS:</strong></span>
                    <span id="tps-amount"></span>
                </div>
                <div class="receipt-item">
                    <span><strong>Total:</strong></span>
                    <span id="total-amount"></span>
                </div>
            </div>

            <form id="payment-form">
                <div>
                    <label for="amount">Montant ($):</label>
                    <input type="number" id="amount" name="amount" required readonly>
                </div>
                <button type="submit" class="button">Payer</button>
            </form>
        </div>

        <div id="card-modal" class="modal">
            <div class="modal-content">
                <span class="close" onclick="closeModal()">&times;</span>
                <h2 style="color: #ff007f;">Enter Card Details</h2>
                <form id="card-details-form">
                    <div class="form-group">
                        <label for="name">Name:</label>
                        <input type="text" id="name" required>
                    </div>
                    <div class="form-group">
                        <label for="surname">Surname:</label>
                        <input type="text" id="surname" required>
                    </div>
                    <div class="form-group">
                        <label for="postal-code">Postal Code:</label>
                        <input type="text" id="postal-code" required>
                    </div>
                    <div class="form-group">
                        <label for="phone-number">Phone Number:</label>
                        <input type="text" id="phone-number" required>
                    </div>
                    <div class="form-group">
                        <label for="address">Address:</label>
                        <input type="text" id="address" required>
                    </div>
                    <div class="form-group">
                        <label for="card-number">Card Number:</label>
                        <input type="text" id="card-number" required>
                    </div>
                    <div class="form-group">
                        <label for="expiry">Expiry Date:</label>
                        <input type="text" id="expiry" placeholder="MM/YY" required>
                    </div>
                    <div class="form-group">
                        <label for="cvv">CVV:</label>
                        <input type="text" id="cvv" required>
                    </div>
                    <button type="submit" class="submit-button">Submit Payment</button>
                </form>
            </div>
        </div>
        <script>
            // Get the amount from the URL parameters
            const urlParams = new URLSearchParams(window.location.search);
            const amount = parseFloat(urlParams.get('amount')) || 0;
            if (amount) {
                document.getElementById('amount').value = amount;
                document.getElementById('initial-amount').innerText = `$${amount.toFixed(2)}`; // Initial amount

                const tvqRate = 0.09975; // Example TVQ rate
                const tpsRate = 0.05; // Example TPS rate

                const tvqAmount = amount * tvqRate;
                const tpsAmount = amount * tpsRate;
                const totalAmount = amount + tvqAmount + tpsAmount;

                document.getElementById('tvq-amount').innerText = `$${tvqAmount.toFixed(2)}`; // TVQ amount
                document.getElementById('tps-amount').innerText = `$${tpsAmount.toFixed(2)}`; // TPS amount
                document.getElementById('total-amount').innerText = `$${totalAmount.toFixed(2)}`; // Total amount

                // Set the amount input to the total amount
                document.getElementById('amount').value = totalAmount.toFixed(2);
            }

            const modal = document.getElementById("card-modal");

            document.getElementById('payment-form').addEventListener('submit', function (event) {
                event.preventDefault();
                modal.style.display = "block"; // Show the modal
            });

            function closeModal() {
                modal.style.display = "none"; // Close the modal
            }

            document.getElementById('card-details-form').addEventListener('submit', async function (event) {
                event.preventDefault();

                const name = document.getElementById('name').value;
                const surname = document.getElementById('surname').value;
                const postalCode = document.getElementById('postal-code').value;
                const phoneNumber = document.getElementById('phone-number').value;
                const address = document.getElementById('address').value;
                const cardNumber = document.getElementById('card-number').value;
                const expiry = document.getElementById('expiry').value;
                const cvv = document.getElementById('cvv').value;

                console.log('Card Details:', name, surname, postalCode, phoneNumber, address, cardNumber, expiry, cvv);

                // Process payment here with card details
                // For demonstration, we'll just close the modal
                closeModal(); // Close the modal after submission

                // After closing the modal, you can proceed with further actions like sending card details to your server
            });

            document.getElementById('payment-form').addEventListener('submit', async (event) => {
                event.preventDefault();
                const amount = document.getElementById('amount').value;

                // Send payment data to your server
                const response = await fetch('/event/payment', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ amount })
                });

                const result = await response.json();
                if (result.success) {
                    alert('Payment successful!');
                    window.location.href = '/'; // Redirect to the homepage or confirmation page
                } else {
                    alert('Payment failed: ' + result.message);
                }
            });
        </script>

        <%- include("../partials/footer.ejs") %>