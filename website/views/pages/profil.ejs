<%- include ("../partials/header.ejs") %>
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-y: auto;
            box-sizing: border-box;
            font-family: "Orbitron", sans-serif;
        }

        body {
            background-color: #000000;
            color: #ffffff;
        }

        .main-content {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 20px;
            gap: 10px;
        }

        .profile-container,
        .modify-profile-container {
            width: 100%;
            /* or max-width: 400px; */
        }

        .profile-container,
        .preview-container {
            width: 100%;
            /* or max-width: 400px; */
        }


        .profile-container {
            background: linear-gradient(45deg, #d44fdc, #e38be3, #f0b7f5);
            border-radius: 15px;
            padding: 20px;
            width: 400px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            transition: transform 0.5s ease, opacity 0.5s ease;
            transform: scale(0.8);
            opacity: 0;
        }

        .profile-container.active {
            opacity: 1;
            transform: scale(1);
        }

        .profile-arrow {
            font-size: 24px;
            cursor: pointer;
            color: #ffffff;
            position: relative;
            top: 40px;
            margin: 0 20px;
            transition: color 0.3s ease;
            display: block;
            z-index: 10;


        }

        .profile-arrow:hover {
            color: #e04e2e;
        }

        .profile-container {
            transition: transform 0.5s ease;
        }

        .profile-header {
            text-align: center;
            margin-bottom: 15px;
        }

        .profile-picture {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            margin-bottom: 10px;
            border: 2px solid #f093fb;
        }

        h1 {
            font-size: 1.5rem;
        }

        .profile-details {
            margin: 15px 0;
            text-align: left;
        }
        a{
            text-decoration: none;
        }

        .edit-profile,
        .change-password,
        .subscription-block {
            background: #333;
            border-radius: 10px;
            padding: 15px;
            margin-top: 15px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
        }

        button {
            padding: 0.75rem;
            background-color: #e04e2e;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 10px;
            transition: background-color 0.3s ease, transform 0.3s ease;
        }

        button:hover {
            background-color: #ff5c33;
            transform: translateY(-2px);
        }

        .subscription-block {
            background: linear-gradient(135deg, #6c63ff, #d44fdc);
        }

        #background-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: -1;
        }

        .modify-profile-container {
            background: linear-gradient(45deg, #d44fdc, #e38be3, #f0b7f5);
            border-radius: 15px;
            padding: 20px;
            width: 400px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            transition: opacity 0.5s ease;
            opacity: 0;
            margin-left: 20px;
            display: none;
        }

        .modify-profile-container.active {
            display: block;
            opacity: 1;
        }

        .preview-container {
            background: rgba(20, 20, 20, 0.8);
            /* Similar to the card background */
            border: 2px solid #00bfff;
            /* Same border color as card */
            border-radius: 15px;
            padding: 20px;
            width: 400px;
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.7), 0 0 40px rgba(0, 255, 255, 0.5);
            transition: opacity 0.5s ease;
            opacity: 0;
            margin-right: 20px;
            display: none;
        }

        .preview-container.active {
            display: block;
            opacity: 1;
        }

        .add-photo-container {
            display: flex;
            justify-content: center;
            margin-top: 10px;
        }

        .add-photo {
            width: 100px;
            height: auto;
            border-radius: 10px;
            margin-bottom: 10px;
            opacity: 0.5;
            border: 2px solid #00bfff;
        }

        .upload-label {
            width: 50px;
            height: 40px;
}

.upload-label:hover {
    background: linear-gradient(135deg, #ff33a8, #ff66c4);
    box-shadow: 0 6px 15px rgba(255, 102, 196, 0.7);
    transform: scale(1.05);
}

.upload-label i {
    font-size: 18px;
    color: white;
}



        .add-photo {
            width: 100px;
            height: auto;
            border-radius: 0;
            margin-bottom: 10px;
            opacity: 0.5;
        }

        .photo-container {
            position: relative;
            display: inline-block;
            margin: 5px;
        }

.delete-photo {
    position: absolute;
    top: 5px;
    right: 5px;
    background: linear-gradient(135deg, #ff3333, #cc0000);
    color: white;
    border: none;
    border-radius: 50%;
    width: 35px;
    height: 35px;
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5);
    font-size: 18px;
    transition: all 0.3s ease;
}

.delete-photo:hover {
    background: linear-gradient(135deg, #ff0000, #990000);
    box-shadow: 0 6px 15px rgba(255, 0, 0, 0.5);
    transform: scale(1.1);
}


        .modify-profile-container {
            background: linear-gradient(135deg, #1d1f29, #2c2f3b);
            border-radius: 15px;
            padding: 30px;
            width: 450px;
            box-shadow: 0 6px 30px rgba(0, 0, 0, 0.6);
            transition: opacity 0.5s ease;
            opacity: 0;
            margin-left: 20px;
            display: none;
            color: #f8f9fa;
        }

        .modify-profile-container.active {
            display: block;
            opacity: 1;
        }

        .modify-profile-container h3 {
            font-size: 1.8rem;
            color: #ff66c4;
            text-shadow: 2px 2px 4px rgba(255, 102, 196, 0.7);
            margin-bottom: 20px;
            text-align: center;
        }

        .edit-profile,
        .change-password {
            background: linear-gradient(135deg, #282c34, #343a46);
            border: 2px solid #ff66c4;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow: 0 4px 20px rgba(255, 102, 196, 0.5);
        }

        .edit-profile h3,
        .change-password h3 {
            font-size: 1.5rem;
            margin-bottom: 10px;
        }

        button {
            display: block;
            width: 100%;
            padding: 0.8rem;
            background: #ff66c4;
            color: #ffffff;
            font-size: 1rem;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            margin-top: 10px;
        }

        button:hover {
            background: #ff33a8;
            transform: translateY(-3px);
        }

        form input {
            width: 90%;
            padding: 10px;
            margin: 10px 0;
            font-size: 1rem;
            color: #fff;
            background: #2d2f3a;
            border: 1px solid #ff66c4;
            border-radius: 5px;
            outline: none;
            transition: border-color 0.3s ease;
        }

        form input:focus {
            border-color: #ff33a8;
        }

        form button {
            background: #66ffcc;
            color: #000;
            margin-top: 15px;
        }

        form button:hover {
            background: #33ff99;
        }

        #update-profile-picture-form {
            margin-top: 20px;
        }

        #update-profile-picture-form label {
            font-size: 1.1rem;
            color: #f8f9fa;
            margin-bottom: 10px;
            display: block;
        }

        #profilePicture {
            display: block;
            margin: 15px 0;
            padding: 10px;
            background: #1f212b;
            color: #fff;
            border: 1px solid #ff66c4;
            border-radius: 5px;
            outline: none;
        }

        #profilePicture:hover {
            border-color: #ff33a8;
        }
    </style>

    <body>
        <video autoplay muted loop id="background-video">
            <source src="/images/vecteezy_polygon-cyberpunk-sci-fi-background_1807028.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video>
        <div class="main-content">
            <div class="profile-arrow left-arrow" title="Preview">&#9664;</div>
            <div class="preview" style="display: none;">
                <div class="preview-container active">
                    <h3>Preview</h3>
                    <div class="profile-header">
                        <h1>Profil</h1>
                        <div class="add-photo-container">
                            <button class="upload-label" id="upload-button">+</button>
                            <input type="file" id="file-upload" name="photos" style="display: none;" accept="image/*"
                                multiple>
                        </div>

                    </div>
                    <div class="profile-details">
                        <p><strong>Nom:</strong> <span id="user-nom">
                                <%= userDetails.e_nom %>
                            </span></p>
                    </div>
                    <div class="uploaded-photos" style="display: flex; flex-wrap: wrap; gap: 10px;">
                        <% if (userPhotos.length) { %>
                            <% userPhotos.forEach(photo=> { %>
                                <div class="photo-container">
                                    <img src="/uploads/<%= photo %>" alt="Uploaded Photo" class="add-photo"
                                        style="width: 100px; height: 100px; object-fit: cover;">
                                    <button class="delete-photo" data-photo="<%= photo %>">
                                        <i class="fas fa-times"></i>X
                                    </button>
                                </div>
                                <% }); %>
                                    <% } else { %>
                                        <p>Aucune photo téléchargée.</p>
                                        <% } %>
                    </div>
                    <!-- Display User Card Preferences -->
                    <div class="user-preference">
                        <h3>Préférence de Carte:</h3>
                        <p>
                            <% if (cardPreferences.length> 0) { %>
                                <ul>
                                    <% cardPreferences.forEach(cardId=> { %>
                                        <li>
                                            <%= cardId %>
                                        </li> <!-- Replace this with the actual card name if you want -->
                                        <% }); %>
                                </ul>
                                <% } else { %>
                                    <p>Aucune carte sélectionnée.</p>
                                    <% } %>
                        </p>
                    </div>

                    <!-- Display User Likes Preferences -->
                    <div class="user-likes">
                        <h3>Préférences de Likes:</h3>
                        <% if (likePreferences.length> 0) { %>
                            <ul>
                                <% likePreferences.forEach(likeId=> { %>
                                    <li>
                                        <%= likeId %>
                                    </li> <!-- Replace this with the actual like name if you want -->
                                    <% }); %>
                            </ul>
                            <% } else { %>
                                <p>Aucun like sélectionné.</p>
                                <% } %>
                    </div>

                </div>
            </div>


            <div class="profile-container">
                <div class="profile-header">
                    <h1>Profil</h1>
                    <img src="/uploads/<%= userDetails.e_photo %>" alt="Photo de Profil" class="profile-picture">
                </div>
                <div class="profile-details">
                    <p><strong>Prénom:</strong> <span id="user-prenom">
                            <%= userDetails.e_prenom %>
                        </span></p>
                    <p><strong>Nom:</strong> <span id="user-nom">
                            <%= userDetails.e_nom %>
                        </span></p>
                    <p><strong>Email:</strong> <span id="user-email">
                            <%= userDetails.e_courriel %>
                        </span></p>
                    <p><strong>Votre abonnement actuel:</strong> <span>
                            <%= subscriptionName %>
                        </span></p>
                    
                    
                </div>

                <div class="profile-actions">
                    <form action="/event/delete-account" method="POST"
                        onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre compte? Cette action est irréversible.');">
                        <button type="submit">Supprimer le Compte</button>
                    </form>
                </div>

                <div class="subscription-block">
                    <h3>Votre abonnement actuel :</h3>
                    <p>
                        <%= subscriptionName %>
                    </p>
                    <p>Souhaitez-vous obtenir un autre abonnement ?</p>
                    <a href="/event/abonnement">
                        <button>Changer abonnement</button>
                    </a>
                </div>
            </div>
            <div class="modify-profile-container" style="display: none;">
                <h3>Modifier le Profil</h3>
                <div class="edit-profile">
                    <h3>Modifier les informations du profil</h3>
                    <button id="edit-profile-btn">Modifier le Profil</button>
                    <form id="update-profile-form" style="display: none;">
                        <input type="text" name="new_firstName" placeholder="Prénom" required>
                        <input type="text" name="new_lastName" placeholder="Nom" required>
                        <input type="email" name="new_email" placeholder="Email" required>
                        <button type="submit">Mettre à jour le profil</button>
                    </form>
                </div>

                <div class="change-password">
                    <h3>Changer le Mot de Passe</h3>
                    <button id="change-password-btn">Changer le Mot de Passe</button>
                    <form id="change-password-form" style="display: none;" method="POST"
                        action="/event/change-password">
                        <input type="password" name="old_password" placeholder="Ancien mot de passe" required>
                        <input type="password" name="new_password" placeholder="Nouveau mot de passe" required>
                        <input type="password" name="confirm_password" placeholder="Confirmer le nouveau mot de passe"
                            required>
                        <button type="submit">Changer le Mot de Passe</button>
                    </form>
                </div>
                <form id="update-profile-picture-form" enctype="multipart/form-data">
                    <label for="profilePicture">Upload New Profile Picture:</label>
                    <input type="file" id="profilePicture" name="profilePicture" accept="image/*" required>
                    <button type="submit">Update Picture</button>
                </form>
            </div>
            <div class="profile-arrow right-arrow" title="Modifier profil">&#9654;</div>


        </div>


        <script>
            window.addEventListener('load', function () {
                const profileContainer = document.querySelector('.profile-container');
                setTimeout(() => {
                    profileContainer.classList.add('active');
                }, 100);
            });

            const leftArrow = document.querySelector('.left-arrow');
            const rightArrow = document.querySelector('.right-arrow');
            const profileContainer = document.querySelector('.profile-container');
            const modifyProfileContainer = document.querySelector('.modify-profile-container');
            const preview = document.querySelector('.preview');

            let isProfileVisible = true;

            leftArrow.addEventListener('click', function () {
                console.log(isProfileVisible);
                if (!isProfileVisible) {
                    modifyProfileContainer.style.opacity = '0';
                    setTimeout(() => {
                        profileContainer.style.transition = 'transform 0.5s ease';
                        profileContainer.style.transform = 'translateX(0)';
                        modifyProfileContainer.classList.remove('active');
                        modifyProfileContainer.style.display = 'none';
                        rightArrow.style.display = 'block';
                        isProfileVisible = true;
                    }, 500);
                } else {
                    profileContainer.style.transition = 'transform 0.5s ease';
                    profileContainer.style.transform = 'translateX(100%)';
                    setTimeout(() => {
                        preview.classList.add('active');
                        preview.style.display = 'block';
                        preview.style.opacity = '1';
                        leftArrow.style.display = 'none';
                        rightArrow.style.display = 'block';
                        isProfileVisible = false;
                    }, 500);
                }
            });

            rightArrow.addEventListener('click', function () {
                console.log(isProfileVisible);
                if (!isProfileVisible) {
                    preview.style.opacity = '0';
                    setTimeout(() => {
                        profileContainer.style.transition = 'transform 0.5s ease';
                        profileContainer.style.transform = 'translateX(0)';
                        preview.classList.remove('active');
                        preview.style.display = 'none';
                        leftArrow.style.display = 'block';
                        isProfileVisible = true;
                    }, 500);
                } else {

                    profileContainer.style.transition = 'transform 0.5s ease';
                    profileContainer.style.transform = 'translateX(-100%)';
                    setTimeout(() => {
                        modifyProfileContainer.classList.add('active');
                        modifyProfileContainer.style.display = 'block';
                        modifyProfileContainer.style.opacity = '1';
                        leftArrow.style.display = 'block';
                        rightArrow.style.display = 'none';
                        isProfileVisible = false;
                    }, 500);
                }
            });

            document.getElementById("edit-profile-btn").addEventListener("click", function () {
                const form = document.getElementById("update-profile-form");
                form.style.display = form.style.display === "none" ? "block" : "none";
            });

            document.getElementById("change-password-btn").addEventListener("click", function () {
                const form = document.getElementById("change-password-form");
                form.style.display = form.style.display === "none" ? "block" : "none";
            });


            document.getElementById("change-password-form").addEventListener("submit", function (event) {
                event.preventDefault();

                const formData = new FormData(this);

                fetch("/event/change-password", {
                    method: "POST",
                    body: new URLSearchParams(formData),
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                        } else {
                            alert(data.message);
                        }
                    });
            });

            document.getElementById("update-profile-form").addEventListener("submit", function (event) {
                event.preventDefault();

                const formData = new FormData(this);

                fetch("/event/update-profile", {
                    method: "POST",
                    body: new URLSearchParams(formData),
                    headers: {
                        "Content-Type": "application/x-www-form-urlencoded"
                    }
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.querySelector("#user-prenom").textContent = formData.get("new_firstName");
                            document.querySelector("#user-nom").textContent = formData.get("new_lastName");

                            setTimeout(() => {
                                location.reload();
                            }, 500);

                            alert(data.message);
                        } else {
                            alert(data.message);
                        }
                    });
            });

            document.querySelector('.upload-label').addEventListener('click', function () {
                document.getElementById('file-upload').click();
            });

            document.getElementById('file-upload').addEventListener('change', function (event) {
                console.log("File input changed");
                const files = event.target.files;
                const formData = new FormData();

                for (let i = 0; i < files.length; i++) {
                    formData.append('photos', files[i]);
                }
                fetch('/event/update-photos', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert('Photos uploaded successfully!');
                            location.reload();
                        } else {
                            alert('Failed to upload photos: ' + data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error uploading photos:', error);
                    });
            });



            document.querySelectorAll('.delete-photo').forEach(button => {
                button.addEventListener('click', function () {
                    const photoUrl = this.getAttribute('data-photo');

                    fetch(`/event/delete-photo/${photoUrl}`, {
                        method: 'DELETE'
                    })
                        .then(response => {
                            if (response.ok) {
                                alert('Photo deleted successfully!');
                                location.reload();
                            } else {
                                alert('Failed to delete photo: ' + response.statusText);
                            }
                        })
                        .catch(error => {
                            console.error('Error deleting photo:', error);
                        });
                });
            });

            document.getElementById('update-profile-picture-form').addEventListener('submit', function (e) {
                e.preventDefault();

                const formData = new FormData(this);

                fetch('/event/update-profile-picture', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            alert(data.message);
                            document.querySelector('.profile-picture').src = data.photoUrl; // Update profile picture on the page
                        } else {
                            alert(data.message);
                        }
                    })
                    .catch(error => {
                        console.error('Error updating profile picture:', error);
                    });
            });
        </script>
    </body>