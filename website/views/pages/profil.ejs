<%- include ("../partials/header.ejs") %>
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil Utilisateur</title>
    <link rel="stylesheet" href="styles.css">
</head>
<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Arial', sans-serif;
    background-color: #000000;
    margin: 0;
    padding: 0;
}

.main-content {
    justify-content: center;
    align-items: center; /* Centrer verticalement */
    height: 100vh; /* Utiliser toute la hauteur de la fenêtre */
    padding-top: 0;
}

.profile-container {
    background-color: #f093fb; /* Couleur de départ */
    padding: 1.5rem; /* Réduction du padding pour diminuer la hauteur */
    border-radius: 10px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    width: 400px; /* Garde la largeur */
    text-align: center;
    margin: 0 auto; /* Centrer horizontalement */
    z-index: 1;

    /* Animation */
    top: 0;
    left: 50%;
    transform: translateX(-50%) scale(0); /* Démarre à scale 0 */
    opacity: 0; /* Démarre avec opacité 0 */
    transition: transform 0.5s ease, opacity 0.5s ease, background-color 1s ease;
}

.profile-container.active {
    transform: translateX(-50%) scale(1); /* Apparaît à taille normale */
    opacity: 1; /* Pleine opacité */
    background-color: #f093fb;
}

.profile-header {
    margin-bottom: 1rem; /* Réduction de l'espacement pour diminuer la hauteur */
}

.profile-picture {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    margin-bottom: 1rem;
    object-fit: cover;
    border: 2px solid #f093fb;
}

h1 {
    font-size: 1.2rem; /* Réduction de la taille de la police */
    color: #333;
}

.profile-details p {
    font-size: 1rem;
    margin-bottom: 0.5rem; /* Réduction de la marge inférieure */
    color: #666;
}

.profile-details strong {
    color: #000000;
}

.profile-actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem; /* Réduction de l'écart entre les boutons */
}

.profile-actions button {
    padding: 0.5rem; /* Réduction du padding pour diminuer la hauteur des boutons */
    border: none;
    background-color: white;
    color: black;
    font-size: 1rem;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.profile-actions button:hover {
    background-color: #e04e2e;
}

.change-password h3 {
    color: #333;
    margin-bottom: 1rem;
}

.change-password form div {
    margin-bottom: 0.75rem; /* Réduction des marges */
}

.change-password form label {
    display: block;
    font-weight: bold;
    margin-bottom: 0.5rem;
    color: #f093fb;
}

.change-password form input {
    width: 100%;
    padding: 0.5rem;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 1rem;
}

.change-password button {
    padding: 0.5rem; /* Réduction du padding pour diminuer la hauteur */
    border: none;
    background-color: #f093fb;
    color: black;
    font-size: 1rem;
    border-radius: 5px;
    cursor: pointer;
    transition: background-color 0.3s ease;
}

.change-password button:hover {
    background-color: #e04e2e;
}

</style>
<body>
    <div class="main-content">
        <div class="profile-container">
            <div class="profile-header">
                <h1>Profil <span id="user-prenom"></span> <span id="user-nom"></span></h1>
            </div>
            <div class="profile-details">
                <p><strong><%= userDetails.e_nom %></strong></p>
                <p><strong><%= userDetails.e_prenom %></strong></p>
                <p><strong><%= userDetails.e_courriel %></strong></p>
                <p><strong>Mot de passe : ••••••••</strong></p> <!-- Masked password -->
            </div>
            
            <!-- Change Password Section -->
            <div class="change-password">
                <h3>Changer le Mot de Passe</h3>
                <form action="/change-password" method="POST">
                    <div>
                        <label for="old-password">Ancien Mot de Passe :</label>
                        <input type="password" id="old-password" name="old_password" required>
                    </div>
                    <div>
                        <label for="new-password">Nouveau Mot de Passe :</label>
                        <input type="password" id="new-password" name="new_password" required>
                    </div>
                    <div>
                        <label for="confirm-password">Confirmer le Nouveau Mot de Passe :</label>
                        <input type="password" id="confirm-password" name="confirm_password" required>
                    </div>
                    <button type="submit">Changer le Mot de Passe</button>
                </form>
                <button class="forgot-password">Mdp Oublier?</button>
            </div>

            <!-- Profile actions -->
            <div class="profile-actions">
                <button>Modifier le Profil</button>
                <button>Supprimer le Compte</button>
            </div>
        </div>
    </div>

    <script>
        // Activer l'animation lors du chargement de la page
        window.addEventListener('load', function() {
            const profileContainer = document.querySelector('.profile-container');
            profileContainer.classList.add('active');
        });
    </script>
</body>
</html>
