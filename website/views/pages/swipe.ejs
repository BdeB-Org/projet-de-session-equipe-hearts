<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/swipe.css" />

<body>
  <!-- <video autoplay muted loop id="background-video">
            <source src="/images/vecteezy_future-cyber-city-ai-generative_31698895.mp4" type="video/mp4">
            Your browser does not support the video tag.
        </video> -->
  <div class="glitch-background"></div>
  <div class="sidebar">
    <div class="user-profile">
      <img src="/uploads/<%= userDetails.e_photo %>" alt="User Profile" class="profile-picture" />
      <div class="profile-info">
        <h3 class="user-name">
          <%= userDetails.e_prenom %>
        </h3>
        <div class="user-icons">
          <a href="/event/profil">
            <i class="fas fa-user-circle icon-img"></i>
          </a>
          <a href="/event/profil">
            <i class="fas fa-comments icon-img"></i>
          </a>
        </div>
      </div>
    </div>
    <h2 class="matches-title">Matches</h2>
    <ul class="matches"></ul>
  </div>

  <!-- Swipe Counter -->
  <div id="swipe-counter">
    <p>Swipes restants : <span id="swipes-left">0</span></p>
  </div>

  <!-- Countdown for reset -->
  <div id="countdown" style="display: none">
    <p>Vous avez atteint votre limite ! Prochains swipes disponibles en :</p>
    <p id="countdown-timer">00:00:00</p>
  </div>

  <div class="card-container"></div>
  <div id="userModal" class="modal">
    <div class="modal-content">
      <span class="close">&times;</span>
      <img id="modalImage" src="" alt="profile picture" style="width: 100px; height: 100px; border-radius: 50%" />
      <h4 id="modalName"></h4>
      <p id="modalDetails"></p>
      <% matches.forEach(function(match) { %>
        <button class="set-date-button" data-match-id="<%= match.match_id %>">Set Date</button>
        <% }); %>
          <button class="unmatch-button"> unmatch</button>


    </div>
    <div id="availabilityModal" class="modal">
      <div class="modal-content">
        <span class="close">&times;</span>
        <h3 id="calendar-title">Sélectionnez vos disponibilités</h3>
        <div class="calendar-container">
          <h2 id="calendar-month">Mois : <span id="currentMonth"></span></h2>
          <div class="calendar-grid">
            <!-- Days and Time Slots will be dynamically populated -->
          </div>
        </div>
        <button id="confirmAvailability">Confirmer</button>
      </div>
    </div>

  </div>
</body>
<script>
  const userId = "<%= userDetails.e_id %>";


  document.addEventListener("DOMContentLoaded", function () {
    let users = [];
    let currentIndex = 0;
    let swipeCount = 0;
    let maxSwipes = 0;
    let swipeLimitReached = false;

    // Define DOM elements in a wider scope
    const swipesLeftElement = document.getElementById("swipes-left");
    const countdownElement = document.getElementById("countdown");
    const countdownTimerElement = document.getElementById("countdown-timer");
    const cardContainer = document.querySelector(".card-container");
    const matchesList = document.querySelector(".matches");
    const modal = document.getElementById("userModal");
    const span = document.getElementsByClassName("close")[0];

    const loggedInUserId = "<%= userDetails.e_id %>"; // Fetch the logged-in user's ID
    const userSubscriptionId = "<%= userDetails.abonnement_id %>"; // Fetch the logged-in user's subscription ID
    const matchessfasf = "<%= userDetails.e_id === matches.user_id ? matches.user_id : matches.user_id %>";
    console.log(matchessfasf);



    // Fetch user preferences
    fetch("/api/user/preferences", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({ userId: loggedInUserId }),
    })
      .then((response) => response.json())
      .then((preferenceResults) => {
        const cardPreferences2 = preferenceResults
          .map((pref) => pref.card_id || null)
          .filter(Boolean);
        const sexualitePreferences = preferenceResults
          .map((pref) => pref.sexualite_id || null)
          .filter(Boolean);

        console.log("Preference Results:", preferenceResults);
        console.log("Card Preferences:", cardPreferences2);
        console.log("Sexualite Preferences:", sexualitePreferences);

        // Set the swipe limit based on subscription type
        switch (parseInt(userSubscriptionId)) {
          case 1: // Basique
            maxSwipes = 5;
            break;
          case 2: // Premium
            maxSwipes = 100;
            break;
          case 3: // Diamant
            maxSwipes = Infinity; // Unlimited swipes
            break;
          default:
            maxSwipes = 0;
        }

        swipesLeftElement.textContent = maxSwipes - swipeCount;

        fetch("/api/users")
          .then((response) => response.json())
          .then((data) => {
            console.log("All Users:", data);

            const loggedInUserLikes = preferenceResults.map(
              (pref) => pref.like_id
            );

            const usersWithSimilarLikes = [];
            const usersWithoutSimilarLikes = [];

            data.forEach((user) => {
              const userLikes = user.likes || [];
              const hasSimilarLikes = userLikes.some((like) =>
                loggedInUserLikes.includes(like)
              );
              if (hasSimilarLikes) {
                usersWithSimilarLikes.push(user);
              } else {
                usersWithoutSimilarLikes.push(user);
              }
            });

            usersWithSimilarLikes.sort((a, b) => {
              const aLikesCount = a.likes.filter((like) =>
                loggedInUserLikes.includes(like)
              ).length;
              const bLikesCount = b.likes.filter((like) =>
                loggedInUserLikes.includes(like)
              ).length;
              return bLikesCount - aLikesCount;
            });

            users = [
              ...usersWithSimilarLikes,
              ...usersWithoutSimilarLikes,
            ].filter(
              (user) =>
                user.e_id !== parseInt(loggedInUserId) &&
                sexualitePreferences.includes(user.sexualite) &&
                cardPreferences2.includes(user.card)
            );

            console.log("Filtered Users:", users);

            fetch("/api/user/matches")
              .then((response) => response.json())
              .then((matches) => {
                matchedUserIds = matches.map((match) => match.e_id);

                users = users.filter(
                  (user) => !matchedUserIds.includes(user.e_id)
                );

                if (users.length === 0) {
                  cardContainer.innerHTML = "<p>No other users found.</p>";
                  return;
                }

                updateUserCard();
              })
              .catch((error) => console.error("Error fetching matches:", error));
          })
          .catch((error) => console.error("Error fetching user data:", error));
      })
      .catch((error) => console.error("Error fetching preferences:", error));

    function setupButtonListeners(user) {
      const likeButton = document.querySelector(".like-button");
      const passButton = document.querySelector(".pass-button");
      const cardElement = document.querySelector(".card");

      if (likeButton) {
        likeButton.addEventListener("click", function () {
          console.log("Like button clicked");
          handleLike(loggedInUserId, user.e_id);
          swipeCount++;
          user.swiped = true; // Mark the user as swiped
          showBounceIcon("heart", cardElement);
          cardElement.classList.add("swipe-right");
          setTimeout(() => nextUser(), 500);
        });
      }

      if (passButton) {
        passButton.addEventListener("click", function () {
          swipeCount++;
          user.swiped = true; // Mark the user as swiped
          showBounceIcon("x", cardElement);
          cardElement.classList.add("swipe-left");
          setTimeout(() => nextUser(), 500);
        });
      }
    }

    function handleLike(userId, likedUserId) {
      console.log(
        `Sending like request from User ${userId} to User ${likedUserId}`
      );

      fetch(`/api/user/like`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ userId: userId, likedUserId: likedUserId }),
      })
        .then((response) => response.json())
        .then((data) => {
          console.log("Response received:", data);
          if (data.match) {
            updateMatchesList(likedUserId);
          }
        })
        .catch((error) => console.error("Error liking user:", error));
    }

    function updateMatchesList(likedUserId) {
      fetch(`/api/user/details/${likedUserId}`)
        .then((response) => {
          if (!response.ok) {
            throw new Error(
              "Network response was not ok " + response.statusText
            );
          }
          return response.json();
        })
        .then((user) => {
          const matchesList = document.querySelector(".matches");
          const li = document.createElement("li");

          const img = document.createElement("img");
          img.src = `/uploads/${user.e_photo}`;
          img.alt = `Photo of ${user.e_nom}`;

          const a = document.createElement("a");
          a.href = `/user/profile/${likedUserId}`;
          a.textContent = user.e_nom; // Place the name inside the <a> tag


          li.appendChild(img);
          li.appendChild(a);
          matchesList.appendChild(li);


        })
        .catch((error) => console.error("Error fetching user details:", error));
    }


    function likeUser(likedUserId) {
      fetch("/api/user/like", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          userId: loggedInUserId,
          likedUserId: likedUserId,
        }),
      })
        .then((response) => response.json())
        .then((data) => {
          if (data.match) {
            displayMatch(data.user);
          }
        });
    }

    function displayMatch(user) {
      const matchesList = document.querySelector(".matches");
      const newItem = document.createElement("li");
      newItem.textContent = `Matched with user ID: ${user.userId}`;
      matchesList.appendChild(newItem);
    }

    function showBounceIcon(type, cardElement) {
      const iconElement = document.createElement("i");

      if (type === "heart") {
        iconElement.classList.add("fas", "fa-heart", "heart-bounce");
      } else if (type === "x") {
        iconElement.classList.add("fas", "fa-times", "x-bounce");
      }

      cardElement.appendChild(iconElement);

      setTimeout(() => {
        iconElement.remove();
      }, 500);
    }

    function nextUser() {
      const cardElement = document.querySelector(".card");

      // Check if swipe limit reached
      if (swipeCount >= maxSwipes) {
        alert("Limit de swipe atteint. Revenez demain!");
        showCountdown();
        swipesLeftElement.textContent = 0;
        return;
      }

      // Increment the current index
      currentIndex = (currentIndex + 1) % users.length;

      // If there are no users left, show a "No more users" message
      if (currentIndex === 0 && users.every((user) => user.swiped)) {
        swipesLeftElement.textContent = maxSwipes - swipeCount;
        cardContainer.innerHTML = "<p>Plus de user. C chien be better.</p>";
        return;
      }

      updateUserCard();
      swipesLeftElement.textContent = maxSwipes - swipeCount;
      cardElement.classList.remove("swipe-right", "swipe-left");
    }

    function updateUserCard() {
      const user = users[currentIndex];

      if (user) {
        // Check if this user is in the list of matched users (exclude them)
        if (matchedUserIds.includes(user.e_id)) {
          return;  // Skip this card and move to the next one
        }

        // Continue displaying the user card if they are not matched
        cardContainer.innerHTML = `
      <div class="card">
        <img src="/uploads/${user.e_photo}" alt="${user.e_nom}">
        <h2>${user.e_prenom}</h2>
        <p>À ${closestCity.distance} kilomètres de distance (${closestCity.city})</p>
        <p>Préférences de Likes: ${user.likes.length > 0 ? user.likes.join(", ") : "Aucune"}</p>
        <button class="button like-button"><i class="fas fa-heart"></i>Aimer</button>
        <button class="button pass-button"><i class="fas fa-times"></i>Passer</button>
      </div>
    `;
        setupButtonListeners(user);
      } else {
        console.warn("No user found at current index:", currentIndex);
      }
    }



    function showCountdown() {
      cardContainer.innerHTML =
        "<p>Revenez demain pour continuer à swiper !</p>";
      countdownElement.style.display = "block";

      const now = new Date();
      const nextReset = new Date();
      nextReset.setHours(24, 0, 0, 0);

      const countdownInterval = setInterval(() => {
        const now = new Date();
        const timeLeft = nextReset - now;

        const hours = Math.floor(
          (timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
        );
        const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

        countdownTimerElement.textContent = `${hours}:${minutes}:${seconds}`;

        if (timeLeft <= 0) {
          clearInterval(countdownInterval);
          location.reload();
        }
      }, 1000);
    }

    span.onclick = function () {
      modal.style.display = "none";
    };

    window.onclick = function (event) {
      if (event.target == modal) {
        modal.style.display = "none";
      }
    };
    const matchesContainer = document.querySelector(".matches");
    matchesContainer.addEventListener("click", function (event) {
      if (event.target.closest("a") && event.target.closest(".matches")) {
        event.preventDefault();
        const userId = event.target.getAttribute("href").split("/").pop();
        fetch(`/api/user/details/${userId}`)
          .then((response) => response.json())
          .then((user) => {
            const modalImage = document.getElementById("modalImage");
            const modalName = document.getElementById("modalName");
            const modalDetails = document.getElementById("modalDetails");
            const modalCard = document.getElementById("modalCard");
            const modalGender = document.getElementById("modalGender");

            modalImage.src = user.e_photo
              ? `/uploads/${user.e_photo}`
              : "/images/placeholder.png";
            modalImage.onerror = () =>
              (modalImage.src = "/images/placeholder.png");
            modalName.textContent = user.e_prenom;

            const preferencesText =
              user.preferences.length > 0
                ? `Likes: ${user.preferences.join(", ")}`
                : "No preferences listed.";

            const cardText =
              user.cards.length > 0
                ? `Card: ${user.cards.join(", ")}`
                : "No card listed.";

            const genderText =
              user.sexualities.length > 0
                ? `Gender: ${user.sexualities.join(", ")}`
                : "No gender listed.";

            modalDetails.innerHTML = `${preferencesText}<br>${cardText}<br>${genderText}`;

            document.getElementById("userModal").style.display = "block";
          })
          .catch((err) => {
            console.error("Failed to fetch user details:", err);
            alert("Failed to load user details.");
          });
      }
    });
  });

  fetch("/api/user/matches")
    .then(response => response.json())
    .then(matches => {
      if (matches.length > 0) {
        const matchesList = document.querySelector(".matches");
        matches.forEach(match => {
          const li = document.createElement("li");

          const img = document.createElement("img");
          img.src = `/uploads/${match.e_photo}`;
          img.alt = `Photo of ${match.e_nom}`;

          const a = document.createElement("a");
          a.href = `/user/profile/${match.e_id}`;
          a.textContent = match.e_nom;

          li.appendChild(img);
          li.appendChild(a);
          matchesList.appendChild(li);
        });
      }
    })
    .catch((error) => console.error("Error fetching matches:", error));

  document.querySelectorAll('.unmatch-button').forEach(button => {
    button.addEventListener('click', function () {
      const matchedUserId = this.getAttribute('data-match-id');

      if (!matchedUserId) {
        console.error("Matched User ID is missing.");
        return;
      }

      // Send unmatch request to the server
      fetch('/api/user/unmatch', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          userId: userId,
          matchedUserId: matchedUserId,
        }),
      })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            // Ensure the element is correctly targeted and removed
            const matchItem = this.closest('li');
            if (matchItem) {
              matchItem.remove(); // Remove the match from the DOM
            }
          }
        })
        .catch(err => console.error('Error unmatching user:', err));
    });
  });



  document.querySelectorAll('.set-date-button').forEach(button => {
    button.addEventListener('click', function () {
      const matchedUserId = this.getAttribute("data-match-id");
      console.log("Matched User ID:", matchedUserId);
      if (!matchedUserId) {
        alert("Matched User ID is missing or invalid.");
        return;
      }
      openCalendarModal(matchedUserId);
    });
  });



  function openCalendarModal(matchId) {
    fetch(`/api/get-availability/${matchId}`)
      .then(response => response.json())
      .then(firstUserAvailability => {
        const availableSlots = firstUserAvailability.map(
          slot => `${slot.date}-${slot.time_range}`
        );

        populateCalendarWithRestrictedOptions(availableSlots);
      })
      .catch(err => console.error("Error fetching availability:", err));
  }


  document.querySelector('#availabilityModal .close').addEventListener('click', () => {
    document.getElementById('availabilityModal').style.display = 'none';
  });


  function populateCalendar(monthName, daysInMonth) {
    const calendarGrid = document.querySelector(".calendar-grid");
    const currentMonth = document.getElementById("currentMonth");
    calendarGrid.innerHTML = "";
    currentMonth.textContent = monthName;

    const timeSlots = ["8h-12h", "12h-15h", "15h-18h", "18h-21h"];

    for (let day = 1; day <= daysInMonth; day++) {
      const dayElement = document.createElement("div");
      dayElement.className = "calendar-day";
      dayElement.innerHTML = `<strong>${day}</strong>`;

      timeSlots.forEach((slot) => {
        const slotElement = document.createElement("div");
        slotElement.className = "time-slot";
        slotElement.textContent = slot;

        slotElement.addEventListener("click", () => {
          slotElement.classList.toggle("selected");
        });

        dayElement.appendChild(slotElement);
      });

      calendarGrid.appendChild(dayElement);
    }
  }

  function populateCalendarWithRestrictedOptions(availableSlots) {
    const calendarGrid = document.querySelector(".calendar-grid");
    const timeSlots = ["8h-12h", "12h-15h", "15h-18h", "18h-21h"];
    const daysInMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getDate();

    for (let day = 1; day <= daysInMonth; day++) {
      const date = new Date();
      date.setDate(day);
      const formattedDate = date.toISOString().split("T")[0];

      const dayElement = document.createElement("div");
      dayElement.className = "calendar-day";
      dayElement.innerHTML = `<strong>${day}</strong>`;

      timeSlots.forEach(slot => {
        const slotKey = `${formattedDate}-${slot}`;
        const slotElement = document.createElement("div");
        slotElement.className = `time-slot ${availableSlots.includes(slotKey) ? "" : "disabled"}`;
        slotElement.textContent = slot;

        if (availableSlots.includes(slotKey)) {
          slotElement.addEventListener("click", () => {
            slotElement.classList.toggle("selected");
          });
        }

        dayElement.appendChild(slotElement);
      });

      calendarGrid.appendChild(dayElement);
    }
  }


  // Call the function when opening the modal
  document.querySelector(".set-date-button").addEventListener("click", () => {
    const daysInMonth = new Date(new Date().getFullYear(), new Date().getMonth() + 1, 0).getDate(); // Calculate days in current month
    const monthName = new Date().toLocaleString("fr-FR", { month: "long" }); // Get current month in French
    populateCalendar(monthName, daysInMonth);

    document.getElementById("availabilityModal").style.display = "block";
  });

  // Close modal
  document.querySelector("#availabilityModal .close").addEventListener("click", () => {
    document.getElementById("availabilityModal").style.display = "none";
  });



  let selectedSlots = []; // Store selected slots

  function selectSlot(slot) {
    const slotKey = `${slot.date}-${slot.time_range}`;
    const index = selectedSlots.findIndex(s => s.date === slot.date && s.time_range === slot.time_range);

    if (index === -1) {
      selectedSlots.push(slot); // Add slot
    } else {
      selectedSlots.splice(index, 1); // Remove slot
    }

    const slotElement = [...document.querySelectorAll('.calendar-slot')].find(
      el => el.dataset.date === slot.date && el.dataset.time_range === slot.time_range
    );

    if (slotElement) {
      slotElement.classList.toggle('selected');
    }

    console.log('Selected slots:', selectedSlots);
  }

  document.getElementById("confirmAvailability").addEventListener("click", () => {
    const matchId = document.querySelector(".set-date-button").getAttribute("data-match-id");
    const selectedSlots = Array.from(document.querySelectorAll(".time-slot.selected")).map(slot => {
      const day = slot.closest(".calendar-day").querySelector("strong").textContent;
      const date = new Date();
      date.setDate(day);
      const formattedDate = date.toISOString().split("T")[0];
      return {
        date: formattedDate,
        time_range: slot.textContent,
      };
    });

    console.log("Selected Slots:", selectedSlots);

    fetch("/api/save-availability", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        userId: userId,
        matchId: matchId,
        availabilities: selectedSlots,
      }),
    })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert("Disponibilités enregistrées !");
          document.getElementById("availabilityModal").style.display = "none";
        } else {
          alert("Erreur lors de l'enregistrement des disponibilités.");
        }
      })
      .catch(err => {
        console.error("Error saving availability:", err.message);
        res.status(500).json({ error: "Database error saving availability.", details: err.message });
      });
  });



</script>