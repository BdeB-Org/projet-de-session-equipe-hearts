<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">

<style>
    body {
        background-color: #0d0d0d;
        color: #ff007f;
        font-family: 'Orbitron', sans-serif;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .header {
        background-color: #ff007f;
        width: 100%;
        padding: 10px;
        text-align: center;
        color: white;
        position: fixed;
        top: 0;
        z-index: 1000;
        font-size: 2em;
        text-transform: uppercase;
        letter-spacing: 2px;
        animation: glitch 1.5s infinite;
    }

    @keyframes glitch {
        0% {
            text-shadow: 2px 2px 2px rgba(255, 0, 127, 0.7);
        }

        25% {
            text-shadow: 5px 5px 2px rgba(255, 0, 127, 0.5);
        }

        50% {
            text-shadow: -5px -5px 2px rgba(0, 255, 255, 0.7);
        }

        75% {
            text-shadow: 10px 10px 2px rgba(255, 0, 127, 0.7);
        }

        100% {
            text-shadow: 0px 0px 2px rgba(255, 0, 127, 0.5);
        }
    }

    .card-container {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 80px;
    }

    .card {
        background: rgba(20, 20, 20, 0.8);
        border: 2px solid #00bfff;
        border-radius: 15px;
        padding: 20px;
        margin: 10px;
        width: 300px;
        box-shadow: 0 0 20px rgba(0, 255, 255, 0.7), 0 0 40px rgba(0, 255, 255, 0.5);
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .card:hover {
        transform: scale(1.1);
        box-shadow: 0 0 40px rgba(0, 255, 255, 1), 0 0 80px rgba(0, 255, 255, 0.7);
    }

    .card img {
        width: 100%;
        border-radius: 10px;
    }

    .button {
        background-color: #00bfff;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s, transform 0.3s;
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .button:hover {
        background-color: #007bbf;
        transform: translateY(-3px);
    }

    .sidebar {
        background-color: #ff007f;
        width: 200px;
        padding: 20px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        z-index: 100;
        box-shadow: 0 0 20px rgba(255, 0, 127, 0.7), 0 0 40px rgba(255, 0, 127, 0.5);
        transition: box-shadow 0.3s;
    }

    .sidebar:hover {
        box-shadow: 0 0 30px rgba(255, 0, 127, 1), 0 0 60px rgba(255, 0, 127, 0.7);
    }

    .matches-title {
        font-size: 1.8em;
        margin-bottom: 20px;
        color: #00bfff;
        text-shadow: 0px 0px 5px #00bfff;
    }

    .matches {
        list-style: none;
        padding: 0;
    }

    .matches li {
        margin: 10px 0;
    }

    .user-profile {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .profile-picture {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        margin-right: 10px;
        border: 2px solid #00bfff;
        box-shadow: 0 0 10px #00bfff;
    }

    .profile-info {
        display: flex;
        align-items: center;
    }

    .user-name {
        color: black;
        margin-right: 10px;
    }

    .user-icons {
        display: flex;
        gap: 10px;
    }

    .icon {
        width: 24px;
        height: 24px;
        color: #000000;
        transition: transform 0.3s;
    }

    .icon:hover {
        transform: scale(1.2);
    }

    .fa-heart {
        color: #ff007f;
    }

    .fa-times {
        color: #ff7f7f;
    }

    .glitch-background {
        background-image: url(/images/cheng-feng-psdV2Rl-GvU-unsplash.jpg);
        background-size: cover;
        background-position: center;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        opacity: 0.3;
    }


    #background-video {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }
</style>

<body>
    <!-- <video autoplay muted loop id="background-video">
        <source src="/images/vecteezy_future-cyber-city-ai-generative_31698895.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video> -->
    <div class="glitch-background"></div>
    <div class="sidebar">
        <div class="user-profile">
            <img src="/uploads/<%= userDetails.e_photo %>" alt="User Profile" class="profile-picture">
            <div class="profile-info">
                <h3 class="user-name">
                    <%= userDetails.e_prenom %>
                </h3>
                <div class="user-icons">
                    <a href="/event/profil">
                        <i class="fas fa-user-circle icon-img"></i>
                    </a>
                    <a href="/event/profil">
                        <i class="fas fa-comments icon-img"></i>
                    </a>

                </div>
            </div>
        </div>
        <h2 class="matches-title">Matches</h2>
        <ul class="matches"></ul>
    </div>

    <div class="card-container"></div>
</body>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        let users = [];
        let currentIndex = 0;

        const loggedInUserId = "<%= userDetails.e_id %>"; // Fetch the logged-in user's ID
        console.log("Logged-in User ID: " + loggedInUserId);

        fetch('/api/users')
            .then(response => response.json())
            .then(data => {
                // Log the fetched data
                console.log("Fetched Users: ", data);

                // Filter out the logged-in user from the list of users
                users = data.filter(user => user.e_id !== parseInt(loggedInUserId));

                console.log("Filtered Users after excluding logged-in user: ", users);

                const cardContainer = document.querySelector('.card-container');
                cardContainer.innerHTML = ''; // Clear previous cards

                // Check if there are any users left to display after filtering
                if (users.length === 0) {
                    cardContainer.innerHTML = '<p>No other users found.</p>';
                    return; // Exit if no users left to show
                }

                // Render the first user
                updateUserCard();
            })
            .catch(error => console.error('Error fetching user data:', error));

        function nextUser() {
            currentIndex = (currentIndex + 1) % users.length; // Cycle through users
            updateUserCard(); // Update the user card
        }

        function updateUserCard() {
            const user = users[currentIndex]; // Get current user
            if (user) {
                const cardContainer = document.querySelector('.card-container');
                cardContainer.innerHTML = `
                <div class="card">
                    <img src="/uploads/${user.e_photo}" alt="${user.e_nom}">
                    <h2>${user.e_nom}</h2>
                    <p>À ${user.distance || 'undefined'} kilomètres de distance</p>
                    <button class="button like-button"><i class="fas fa-heart"></i>Aimer</button>
                    <button class="button pass-button"><i class="fas fa-times"></i>Passer</button>
                </div>
            `;
                setupButtonListeners(user);
            }
        }

        function setupButtonListeners(user) {
            const likeButton = document.querySelector('.like-button');
            const passButton = document.querySelector('.pass-button');

            if (likeButton) {
                likeButton.addEventListener('click', function () {
                    console.log(`User ${user.e_nom} was liked.`);
                    nextUser(); // Show next user
                });
            }

            if (passButton) {
                passButton.addEventListener('click', function () {
                    console.log(`User ${user.e_nom} was passed.`);
                    nextUser(); // Show next user
                });
            }
        }
    });

</script>