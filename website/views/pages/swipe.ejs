<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap" rel="stylesheet">

<style>
    body {
        background-color: #0d0d0d;
        color: #ff007f;
        font-family: 'Orbitron', sans-serif;
        margin: 0;
        padding: 0;
        flex-direction: column;
        align-items: center;
        display: flex;
    }

    .header {
        background-color: #ff007f;
        width: 100%;
        padding: 10px;
        text-align: center;
        color: white;
        position: fixed;
        top: 0;
        z-index: 1000;
        font-size: 2em;
        text-transform: uppercase;
        letter-spacing: 2px;
        animation: glitch 1.5s infinite;
    }

    @keyframes glitch-background {
        0% {
            background-position: 0 0;
            opacity: 0.3;
        }

        25% {
            background-position: 10px 5px;
            opacity: 0.5;
        }

        50% {
            background-position: -10px -5px;
            opacity: 0.6;
        }

        75% {
            background-position: 15px -10px;
            opacity: 0.4;
        }

        100% {
            background-position: 0 0;
            opacity: 0.3;
        }
    }

    .glitch-background {
        background-image: url(/images/cheng-feng-psdV2Rl-GvU-unsplash.jpg);
        background-size: cover;
        background-position: center;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: -1;
        opacity: 0.3;
        animation: glitch-background 2s infinite;
    }

    .card-container {
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        margin-top: 80px;
    }

    .card {
        background: rgba(20, 20, 20, 0.8);
        border: 2px solid #00bfff;
        border-radius: 15px;
        padding: 20px;
        margin: 10px;
        width: 300px;
        box-shadow: 0 0 20px rgba(0, 255, 255, 0.7), 0 0 40px rgba(0, 255, 255, 0.5);
        transition: transform 0.3s, box-shadow 0.3s;
    }

    .card:hover {
        transform: scale(1.1);
        box-shadow: 0 0 40px rgba(0, 255, 255, 1), 0 0 80px rgba(0, 255, 255, 0.7);
    }

    .card img {
        width: 100%;
        border-radius: 10px;
    }

    .button {
        background-color: #00bfff;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 5px;
        cursor: pointer;
        transition: background-color 0.3s, transform 0.3s;
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .button:hover {
        background-color: #007bbf;
        transform: translateY(-3px);
    }

    .sidebar {
        background-color: #ff007f;
        width: 200px;
        padding: 20px;
        height: 100vh;
        position: fixed;
        left: 0;
        top: 0;
        z-index: 100;
        box-shadow: 0 0 20px rgba(255, 0, 127, 0.7), 0 0 40px rgba(255, 0, 127, 0.5);
        transition: box-shadow 0.3s;
    }

    .sidebar:hover {
        box-shadow: 0 0 30px rgba(255, 0, 127, 1), 0 0 60px rgba(255, 0, 127, 0.7);
    }

    .matches-title {
        font-size: 1.8em;
        margin-bottom: 20px;
        color: #00bfff;
        text-shadow: 0px 0px 5px #00bfff;
    }

    .matches {
        list-style: none;
        padding: 0;
    }

    .matches li {
        margin: 10px 0;
    }

    .user-profile {
        display: flex;
        align-items: center;
        margin-bottom: 20px;
    }

    .profile-picture {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        margin-right: 10px;
        border: 2px solid #00bfff;
        box-shadow: 0 0 10px #00bfff;
    }

    .profile-info {
        display: flex;
        align-items: center;
    }

    .user-name {
        color: black;
        margin-right: 10px;
    }

    .user-icons {
        display: flex;
        gap: 10px;
    }

    .icon {
        width: 24px;
        height: 24px;
        color: #000000;
        transition: transform 0.3s;
    }

    .icon:hover {
        transform: scale(1.2);
    }

    .fa-heart {
        color: #ff007f;
    }

    .fa-times {
        color: #ff7f7f;
    }

    #background-video {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
    }

    #swipe-counter {
        margin-top: 20px;
        font-size: 18px;
        color: #00ff00;
    }

    #countdown {
        margin-top: 20px;
        font-size: 18px;
        color: #ffcc00;
    }

    /* Add tilt animations */
    .card.swipe-right {
        transform: translateX(100%) rotate(15deg);
        opacity: 0;
        transition: transform 0.5s ease, opacity 0.5s ease;
    }

    .card.swipe-left {
        transform: translateX(-100%) rotate(-15deg);
        opacity: 0;
        transition: transform 0.5s ease, opacity 0.5s ease;
    }

    /* Heart bounce animation */
    .heart-bounce {
        position: absolute;
        font-size: 40px;
        color: #ff007f;
        animation: bounce 0.5s ease forwards;
        opacity: 0;
        z-index: 1000;
    }

    @keyframes bounce {
        0% {
            opacity: 1;
            transform: scale(0);
        }

        50% {
            transform: scale(1.2);
        }

        100% {
            transform: scale(1);
            opacity: 0;
        }
    }

    /* X bounce animation */
    .x-bounce {
        position: absolute;
        font-size: 40px;
        color: #ff7f7f;
        animation: bounce 0.5s ease forwards;
        opacity: 0;
        z-index: 1000;
    }
</style>

<body>
    <!-- <video autoplay muted loop id="background-video">
        <source src="/images/vecteezy_future-cyber-city-ai-generative_31698895.mp4" type="video/mp4">
        Your browser does not support the video tag.
    </video> -->
    <div class="glitch-background"></div>
    <div class="sidebar">
        <div class="user-profile">
            <img src="/uploads/<%= userDetails.e_photo %>" alt="User Profile" class="profile-picture">
            <div class="profile-info">
                <h3 class="user-name">
                    <%= userDetails.e_prenom %>
                </h3>
                <div class="user-icons">
                    <a href="/event/profil">
                        <i class="fas fa-user-circle icon-img"></i>
                    </a>
                    <a href="/event/profil">
                        <i class="fas fa-comments icon-img"></i>
                    </a>
                </div>
            </div>
        </div>
        <h2 class="matches-title">Matches</h2>
        <ul class="matches"></ul>
    </div>

    <!-- Swipe Counter -->
    <div id="swipe-counter">
        <p>Swipes restants : <span id="swipes-left">0</span></p>
    </div>

    <!-- Countdown for reset -->
    <div id="countdown" style="display: none;">
        <p>Vous avez atteint votre limite ! Prochains swipes disponibles en :</p>
        <p id="countdown-timer">00:00:00</p>
    </div>

    <div class="card-container"></div>

</body>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        let users = [];
        let currentIndex = 0;
        let swipeCount = 0;
        let maxSwipes = 0;
        let swipeLimitReached = false;

        const loggedInUserId = "<%= userDetails.e_id %>"; // Fetch the logged-in user's ID
        const userSubscriptionId = "<%= userDetails.abonnement_id %>"; // Fetch the logged-in user's subscription ID

        // Set the swipe limit based on subscription type
        switch (parseInt(userSubscriptionId)) {
            case 1: // Basique
                maxSwipes = 5;
                break;
            case 2: // Premium
                maxSwipes = 100;
                break;
            case 3: // Diamant
                maxSwipes = Infinity; // Unlimited swipes
                break;
            default:
                maxSwipes = 0;
        }

        const swipesLeftElement = document.getElementById("swipes-left");
        const countdownElement = document.getElementById("countdown");
        const countdownTimerElement = document.getElementById("countdown-timer");
        const cardContainer = document.querySelector('.card-container');

        swipesLeftElement.textContent = maxSwipes - swipeCount;

        fetch('/api/users')
            .then(response => response.json())
            .then(data => {
                console.log(data); // Log the data to check if users are being fetched correctly
                users = data.filter(user => user.e_id !== parseInt(loggedInUserId));

                cardContainer.innerHTML = '';
                if (users.length === 0) {
                    cardContainer.innerHTML = '<p>No other users found.</p>';
                    return;
                }

                updateUserCard(); // Make sure this is called after checking users
            })
            .catch(error => console.error('Error fetching user data:', error));


        function setupButtonListeners(user) {
            const likeButton = document.querySelector('.like-button');
            const passButton = document.querySelector('.pass-button');
            const cardElement = document.querySelector('.card');

            if (likeButton) {
                likeButton.addEventListener('click', function () {
                    swipeCount++;
                    showBounceIcon('heart', cardElement);
                    cardElement.classList.add('swipe-right');
                    setTimeout(() => nextUser(), 500);
                });
            }

            if (passButton) {
                passButton.addEventListener('click', function () {
                    swipeCount++;
                    showBounceIcon('x', cardElement);
                    cardElement.classList.add('swipe-left');
                    setTimeout(() => nextUser(), 500);
                });
            }
        }

        function showBounceIcon(type, cardElement) {
            const iconElement = document.createElement('i');

            if (type === 'heart') {
                iconElement.classList.add('fas', 'fa-heart', 'heart-bounce');
            } else if (type === 'x') {
                iconElement.classList.add('fas', 'fa-times', 'x-bounce');
            }

            cardElement.appendChild(iconElement);

            setTimeout(() => {
                iconElement.remove();
            }, 500);
        }

        function nextUser() {
            const cardElement = document.querySelector('.card');

            if (swipeCount >= maxSwipes) {
                alert('You have reached your daily swipe limit.');
                showCountdown();
                swipesLeftElement.textContent = 0;
                return;
            }

            currentIndex = (currentIndex + 1) % users.length;
            updateUserCard();
            swipesLeftElement.textContent = maxSwipes - swipeCount;

            cardElement.classList.remove('swipe-right', 'swipe-left');
        }

        function updateUserCard() {
            const user = users[currentIndex]; // Get current user
            if (user) {
                cardContainer.innerHTML = `
            <div class="card">
                <img src="/uploads/${user.e_photo}" alt="${user.e_nom}">
                <h2>${user.e_nom}</h2>
                <p>À ${user.distance || 'undefined'} kilomètres de distance</p>
                <p>Préférences de Likes: ${user.likes.length > 0 ? user.likes.join(', ') : 'Aucune'}</p>
                <button class="button like-button"><i class="fas fa-heart"></i>Aimer</button>
                <button class="button pass-button"><i class="fas fa-times"></i>Passer</button>
            </div>
        `;
                setupButtonListeners(user);
            } else {
                console.warn('No user found at current index:', currentIndex); // Warn if no user is found
            }
        }


        function showCountdown() {
            cardContainer.innerHTML = '<p>Revenez demain pour continuer à swiper !</p>';
            countdownElement.style.display = 'block';

            const now = new Date();
            const nextReset = new Date();
            nextReset.setHours(24, 0, 0, 0); // Set to next 12 am (midnight)

            // Update countdown every second
            const countdownInterval = setInterval(() => {
                const now = new Date(); // Recalculate 'now' each second
                const timeLeft = nextReset - now;

                const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

                countdownTimerElement.textContent = `${hours}:${minutes}:${seconds}`;

                if (timeLeft <= 0) {
                    clearInterval(countdownInterval);
                    location.reload(); // Reload the page at 12 am to refresh swipes
                }
            }, 1000);
        }

    });


</script>