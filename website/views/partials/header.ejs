<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enhanced Header Design</title>
    <link href="https://fonts.googleapis.com/css2?family=Inknut+Antiqua:wght@400;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inknut Antiqua', serif;
            margin: 0;
            background-color: #000; 
            height: 100vh;
            overflow: hidden; 
        }

        .header {
    
            top: 0;
            width: 100%;
            z-index: 1000;
            background-image: radial-gradient(circle at 50% 50%, #140017, #000000);
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.5);
            transition: height 0.5s ease;
        }

        .top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 5%;
        }

        .logo img {
            height: 55px;
            width: auto;
        }

        .right-wrapper {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .app-menu {
            cursor: pointer;
            transition: transform 0.2s ease, filter 0.3s ease;
        }

        .navbar {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 10px 0;
            background: linear-gradient(45deg, #d44fdc, #e38be3, #f0b7f5, #d44fdc);
            box-shadow: 0 0 10px #d44fdc, 0 0 15px #e38be3, 0 0 20px #d44fdc;
            transition: transform 0.5s ease, opacity 0.5s ease;
        }

        .navbar-item {
            margin: 0 15px;
            font-size: 16px;
            color: #ffffff;
            text-decoration: none;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            transition: color 0.3s ease;
        }

        .navbar-item:hover {
            color: #ffe600;
        }

        .animation-square {
            top: 0;
            left: 50%;
            transform: translateX(-50%) scale(0); 
            background-color: rgba(212, 79, 220, 0.8); 
            height: 100%; 
            width: 100%; 
            z-index: 999; 
            transition: transform 0.5s ease, opacity 0.5s ease;
            opacity: 0; 
        }

        .animation-square.active {
            transform: translateX(-50%) scale(1); 
            opacity: 1; 
        }
    </style>
</head>

<body>
    <header class="header">
        <div class="top">
            <div class="logo">
                <img src="/images/logo_black.png" alt="Hearts Logo">
            </div>
            <div class="right-wrapper">
                <svg class="app-menu" width="24px" height="24px" viewBox="0 0 26.75 26.75" fill="#fff">
                    <circle cx="3.25" cy="3.25" r="3.25" />
                    <circle cx="13.38" cy="3.25" r="3.25" />
                    <circle cx="23.5" cy="3.25" r="3.25" />
                    <circle cx="3.25" cy="13.38" r="3.25" />
                    <circle cx="13.38" cy="13.38" r="3.25" />
                    <circle cx="23.5" cy="13.38" r="3.25" />
                    <circle cx="3.25" cy="23.5" r="3.25" />
                    <circle cx="13.38" cy="23.5" r="3.25" />
                    <circle cx="23.5" cy="23.5" r="3.25" />
                </svg>
            </div>
        </div>
        <nav class="navbar" id="navbar">
            <a class="navbar-item" href="/">Accueil</a>
            <a class="navbar-item" href="/event/creationCompte">Connexion</a>
            <a class="navbar-item" href="/event/abonnement">Abonnement</a>
            <a class="navbar-item" href="/event/swipe">Swipe</a>
            <a class="navbar-item" href="/event/inscription">Inscription</a>
        </nav>
        <div class="animation-square" id="animationSquare"></div>
    </header>
    <main>
        <h1></h1>
    </main>

    <script>
        const appMenu = document.querySelector('.app-menu');
        const navbar = document.getElementById('navbar');
        const animationSquare = document.getElementById('animationSquare');
        let navbarVisible = true; 

        appMenu.addEventListener('click', () => {
            if (navbarVisible) {
                
                animationSquare.classList.add('active');
                navbar.style.transform = 'scale(0.1)'; 
                navbar.style.opacity = '0'; 
                navbarVisible = false;

                
                setTimeout(() => {
                    navbar.style.display = 'none'; 
                }, 500); 
            } else {
               
                navbar.style.display = 'flex'; 
                navbar.style.transform = 'scale(1)'; 
                navbar.style.opacity = '0'; 
                animationSquare.classList.remove('active'); 

                
                setTimeout(() => {
                    navbar.style.opacity = '1'; 
                }, 20); 

                navbarVisible = true; 
            }
        });
    </script>
</body>

</html>
